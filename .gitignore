# Game media and anything derived from it never goes in the repo.
extracted/
*.xex
*.iso
*.zip
*.bik
*.pck
# Codegen output (translated game code) lives in the private -generated repo;
# only the SDK's CMake glue is tracked.
forza-recomp/generated/*
forza-recomp/generated_tu4/
!forza-recomp/generated/rexglue.cmake
forza-recomp/out/
forza-recomp/codegen-warnings.log
# Ghidra projects (analysis of the game binary)
ghidra_projects/
# Build/editor noise
__pycache__/
*.pyc
.vscode/
.idea/
.claude/settings.local.json
# Screenshots of the game (derived from game assets)
screenshots/
# Forza Live server data (server/forza_live_server.py --data-dir default)
forza_live_data/
tools/unxmem
# DLC packages the user dropped in for testing (game data)
HorizonDLC/
flatpak/stage/
# Flatpak build products (flatpak/stage.py, flatpak-builder)
.flatpak-builder/
flatpak-build-dir/
flatpak-repo/
*.flatpak
HorizonISO/
