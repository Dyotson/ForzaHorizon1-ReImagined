diff --git a/include/rex/graphics/fh1_partial_policy.h b/include/rex/graphics/fh1_partial_policy.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_partial_policy.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <array>
+#include <charconv>
+#include <string_view>
+namespace fh1::partial {
+struct Identity {uint32_t session=0,screen=0,graphics=0,core=0,camera=0,selected=0;uint64_t generation=0,issued=0;};
+inline Identity Parse(std::string_view s){std::array<uint64_t,8> v{};for(size_t i=0;i<v.size();++i){const auto end=s.find(',');const auto part=s.substr(0,end);auto r=std::from_chars(part.data(),part.data()+part.size(),v[i]);if(r.ec!=std::errc{}||r.ptr!=part.data()+part.size()||(i<7&&end==s.npos)||(i==7&&end!=s.npos))return {};if(i<7)s.remove_prefix(end+1);}for(size_t i=0;i<6;++i)if(!v[i]||v[i]>UINT32_MAX)return {};if(!v[6]||!v[7])return {};return {uint32_t(v[0]),uint32_t(v[1]),uint32_t(v[2]),uint32_t(v[3]),uint32_t(v[4]),uint32_t(v[5]),v[6],v[7]};}
+inline bool Same(const Identity&a,const Identity&b){return a.session==b.session&&a.screen==b.screen&&a.graphics==b.graphics&&a.core==b.core&&a.camera==b.camera&&a.selected==b.selected&&a.generation==b.generation;}
+inline bool Fresh(const Identity&i,uint32_t token,uint64_t now){return i.session&&i.session==token&&i.screen&&i.graphics&&i.core&&i.camera&&i.selected&&i.generation&&i.issued&&now>=i.issued&&now-i.issued<=250000;}
+inline bool Matches(const Identity&i,const recorded::Context&c){return c.valid&&c.graphics==i.graphics&&c.core==i.core&&c.camera==i.camera&&c.selected==i.selected&&c.world_generation==i.generation;}
+enum class Reason:uint32_t {Off,NoFrame,NoUID,Source,Changed,Eligible};
+struct Permit {
+ Identity source{};uint32_t uid=0,frame=0;uint64_t replay=0;
+ void Reset(){source={};uid=frame=0;replay=0;}
+ void Refresh(bool requested,const Identity&i,uint32_t token,uint64_t now,uint32_t allowed){if(!requested||!Fresh(i,token,now)||!allowed||allowed!=uid||(uid&&!Same(i,source)))Reset();}
+ bool Begin(bool requested,const Identity&i,uint32_t token,uint64_t now,const recorded::Context&c,uint32_t allowed){Reset();if(!requested||!Fresh(i,token,now)||!allowed||c.uid!=allowed||!Matches(i,c))return false;source=i;uid=c.uid;frame=c.frame;replay=c.replay;return true;}
+ Reason Check(bool requested,const Identity&i,uint32_t token,uint64_t now,const recorded::Context&c,uint32_t allowed)const{if(!requested)return Reason::Off;if(!c.valid||!uid)return Reason::NoFrame;if(!allowed||allowed!=uid||c.uid!=allowed)return Reason::NoUID;if(!Fresh(i,token,now))return Reason::Source;if(!Same(i,source)||!Matches(i,c)||c.frame!=frame||c.replay!=replay)return Reason::Changed;return Reason::Eligible;}
+};
+}
diff --git a/include/rex/graphics/fh1_partial_receipts.h b/include/rex/graphics/fh1_partial_receipts.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_partial_receipts.h
@@ -0,0 +1,19 @@
+#pragma once
+// Diagnostic receipts only. No value in this header authorizes a raster.
+namespace fh1::partial {
+inline bool SameScene(const Identity&a,const Identity&b){return a.screen==b.screen&&a.graphics==b.graphics&&a.core==b.core&&a.camera==b.camera&&a.selected==b.selected&&a.generation==b.generation;}
+struct SealReceipt {uint32_t record_uid=0,sealed_uid=0;uint64_t us=0;Identity source{};};
+inline SealReceipt ParseSeal(std::string_view s){uint64_t v[3]{};for(size_t i=0;i<3;++i){const auto n=s.find(',');if(n==s.npos)return {};const auto part=s.substr(0,n);auto r=std::from_chars(part.data(),part.data()+part.size(),v[i]);if(r.ec!=std::errc{}||r.ptr!=part.data()+part.size())return {};s.remove_prefix(n+1);}if(v[0]>UINT32_MAX||v[1]>UINT32_MAX)return {};return {uint32_t(v[0]),uint32_t(v[1]),v[2],Parse(s)};}
+inline uint64_t Age(uint64_t now,uint64_t stamp){return stamp&&now>=stamp?now-stamp:UINT64_MAX;}
+struct Receipts {
+ Identity session{};bool active=false;uint32_t rows=0,end_rows=0,first_accepted_uid=0,first_permitted_uid=0;uint64_t first_accepted_us=0,first_permitted_us=0,first_source_age=UINT64_MAX,first_seal_age=UINT64_MAX,frames=0,seen=0,eligible=0,rejected=0,suppressed=0;Reason last_reason=Reason::Off;
+ bool HasSource(bool requested,const Identity&i,uint32_t token)const{return requested&&i.session&&i.session==token&&i.screen&&i.graphics&&i.core&&i.camera&&i.selected&&i.generation&&i.issued;}
+ bool NeedsStart(bool requested,const Identity&i,uint32_t token)const{return HasSource(requested,i,token)&&(!active||!SameScene(session,i));}
+ void Start(const Identity&i){*this={};session=i;active=true;}
+ void Accept(uint32_t uid,uint64_t now,const Identity&i,const SealReceipt&seal){if(!active||!uid)return;if(!first_accepted_uid){first_accepted_uid=uid;first_accepted_us=now;first_source_age=Age(now,i.issued);first_seal_age=seal.sealed_uid==uid?Age(now,seal.us):UINT64_MAX;}}
+ void Observe(uint32_t uid,Reason reason,uint64_t now){if(!active)return;last_reason=reason;if(uid&&reason==Reason::Eligible&&!first_permitted_uid){first_permitted_uid=uid;first_permitted_us=now;}}
+ bool Frame(uint64_t s,uint64_t e,uint64_t r,uint64_t omit){if(!active)return false;++frames;seen+=s;eligible+=e;rejected+=r;suppressed+=omit;if(rows==720)return false;++rows;return true;}
+ bool Summary(){if(!active||end_rows==128)return false;++end_rows;return true;}
+ void Stop(){active=false;}
+};
+}
diff --git a/include/rex/graphics/fh1_provenance.h b/include/rex/graphics/fh1_provenance.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_provenance.h
@@ -0,0 +1,198 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <span>
+#include <cstddef>
+#include <atomic>
+
+// Phase A is observation only. This protocol never authorizes a raster change.
+namespace fh1::provenance {
+constexpr uint32_t kMagic=0x46483150, kVersion=1, kWords=10;
+constexpr uint32_t kNop=0xC0001000u|((kWords-1)<<16);
+inline void StoreBigEndian(uint8_t* destination,uint32_t value) {
+  for(unsigned i=0;i<4;++i)destination[i]=uint8_t(value>>(24-i*8));
+}
+inline uint32_t NextId(std::atomic<uint32_t>& counter) {
+  auto old=counter.load();
+  while(old!=UINT32_MAX){if(counter.compare_exchange_weak(old,old+1))return old+1;}
+  return 0; // Exhausted for process lifetime, never wraps to a reused token.
+}
+inline bool TraceAllowed(bool armed,uint32_t eligible,uint32_t& records) {
+  return armed&&eligible&&records<4096?(++records,true):false;
+}
+enum class Op:uint16_t {Reset=1,FrameBegin,FrameEnd,Begin,End,Target,Context};
+enum class Phase:uint32_t {Unknown,OriginalFrame,PlayerCar,OtherCar,Scene,Sky};
+struct Record {
+  Op op=Op::Reset;uint32_t token=0,serial=0;Phase phase=Phase::Unknown;
+  // Target records: native color0/depth, their native descriptor28/32 words,
+  // and binding serial. Context records carry graphics/core/camera/car/generation.
+  std::array<uint32_t,5> data{};
+};
+inline std::array<uint32_t,kWords> Encode(const Record& r) {
+  return {kMagic,(kVersion<<16)|uint16_t(r.op),r.token,r.serial,uint32_t(r.phase),
+          r.data[0],r.data[1],r.data[2],r.data[3],r.data[4]};
+}
+enum class DecodeResult {Unrelated,Valid,Malformed};
+inline DecodeResult Decode(std::span<const uint32_t> words,Record& r) {
+  if(words.empty()||words[0]!=kMagic)return DecodeResult::Unrelated;
+  if(words.size()!=kWords||words[1]>>16!=kVersion||
+     uint16_t(words[1])<uint16_t(Op::Reset)||uint16_t(words[1])>uint16_t(Op::Context)||
+     words[4]>uint32_t(Phase::Sky))return DecodeResult::Malformed;
+  r={Op(uint16_t(words[1])),words[2],words[3],Phase(words[4]),
+     {words[5],words[6],words[7],words[8],words[9]}};
+  return DecodeResult::Valid;
+}
+struct Context {
+  Phase phase=Phase::Unknown;
+  uint32_t token=0,frame=0,binding=0,color=0,depth=0,color_desc=0,depth_desc=0;
+  bool valid=false; // Valid provenance, never a main-target/auxiliary classification.
+};
+class Consumer {
+ public:
+  void Eligibility(uint32_t token) {
+    if(token!=eligible_){Reset();eligible_=token;last_frame_=0;}
+  }
+  void Reset() {current_={};depth_=0;last_serial_=0;fault_=false;}
+  void Fault() {current_={};depth_=0;fault_=true;}
+  Context context()const{return current_;}
+  bool fault()const{return fault_;}
+  uint32_t eligible()const{return eligible_;}
+  void Consume(std::span<const uint32_t> words) {
+    if(!eligible_)return;
+    Record r;const auto d=Decode(words,r);
+    if(d==DecodeResult::Unrelated)return;
+    if(d!=DecodeResult::Valid||r.token!=eligible_){Fault();return;}
+    if(r.op==Op::Reset){Reset();return;}
+    if(r.op==Op::FrameBegin) {
+      if(current_.valid||!r.serial||r.serial<=last_frame_){Fault();return;}
+      Reset();last_frame_=r.serial;last_serial_=r.serial;
+      current_={Phase::Unknown,r.token,r.serial,0,0,0,0,0,true};return;
+    }
+    if(fault_||!current_.valid)return;
+    if(r.op==Op::FrameEnd) {
+      if(depth_||r.serial!=current_.frame){Fault();return;}
+      Reset();return;
+    }
+    if(r.op==Op::Begin) {
+      if(depth_==stack_.size()||r.serial<=last_serial_){Fault();return;}
+      stack_[depth_++]={current_.phase,r.serial};last_serial_=r.serial;
+      current_.phase=r.phase;return;
+    }
+    if(r.op==Op::End) {
+      if(!depth_||stack_[depth_-1].serial!=r.serial){Fault();return;}
+      current_.phase=stack_[--depth_].phase;return;
+    }
+    if(r.serial<=last_serial_){Fault();return;}
+    last_serial_=r.serial;
+    if(r.op==Op::Target) {
+      if(!r.data[4]||r.data[4]<=current_.binding){Fault();return;}
+      current_.color=r.data[0];current_.depth=r.data[1];
+      current_.color_desc=r.data[2];current_.depth_desc=r.data[3];current_.binding=r.data[4];
+    }
+  }
+  // Indirect buffers execute synchronously in the same ordered GPU stream.
+  // A native scope may begin in one slab and end in its sibling. Transport
+  // recursion is bounded, but only explicit markers/lifecycle events change
+  // the logical scope. Never restore a stale parent snapshot on ReturnIB.
+  bool EnterBuffer() {
+    if(buffers_==8){Fault();return false;}
+    ++buffers_;return true;
+  }
+  void LeaveBuffer() {
+    if(!buffers_){Fault();return;}
+    --buffers_;
+  }
+ private:
+  struct Entry {Phase phase=Phase::Unknown;uint32_t serial=0;};
+  Context current_{};uint32_t eligible_=0,last_frame_=0,last_serial_=0;
+  size_t depth_=0,buffers_=0;bool fault_=false;
+  std::array<Entry,16> stack_{};
+};
+
+// This is the production NOP parser used by the CP and the byte-path test.
+// Diagnostics may inspect disabled packets, but never enable consumption or
+// introduce a fault when the ordinary disabled path would have skipped them.
+enum class NopDisposition {Disabled,Unrelated,CountMismatch,Consumed,Truncated};
+struct NopReceipt {
+  NopDisposition disposition=NopDisposition::Disabled;
+  uint32_t count=0,available=0;
+  std::array<uint32_t,kWords> words{};
+  bool ok=true,recognized=false;
+};
+template<class Reader> NopReceipt ParseNop(Reader& reader,uint32_t count,Consumer& consumer,
+                                         bool inspect_disabled=false) {
+  NopReceipt result;result.count=count;result.available=reader.read_count();
+  const bool eligible=consumer.eligible()!=0;
+  if(!eligible&&!inspect_disabled){reader.AdvanceRead(count*4);return result;}
+  if(uint64_t(count)*4>reader.read_count()) {
+    result.disposition=NopDisposition::Truncated;
+    if(eligible){consumer.Fault();result.ok=false;}
+    // The disabled production path only advances, even for malformed input.
+    else reader.AdvanceRead(count*4);
+    return result;
+  }
+  if(!count)return result;
+  result.words[0]=reader.template ReadAndSwap<uint32_t>();
+  if(result.words[0]!=kMagic) {
+    reader.AdvanceRead((count-1)*4);result.disposition=NopDisposition::Unrelated;return result;
+  }
+  result.recognized=true;
+  if(count!=kWords) {
+    reader.AdvanceRead((count-1)*4);result.disposition=NopDisposition::CountMismatch;
+    if(eligible)consumer.Fault();return result;
+  }
+  for(uint32_t i=1;i<count;++i)result.words[i]=reader.template ReadAndSwap<uint32_t>();
+  if(eligible){consumer.Consume(result.words);result.disposition=NopDisposition::Consumed;}
+  return result;
+}
+
+// Independent of frame-trace arming and consumer resets. Only diagnostics call
+// this object; production-disabled calls leave every counter and cap untouched.
+struct IngressDiagnostics {
+  uint32_t packets=0,eligible=0,recognized=0,disabled_markers=0,malformed=0;
+  uint32_t epoch=0,lines=0;
+  void Observe(bool enabled,uint32_t token,const NopReceipt& r) {
+    if(!enabled)return;
+    auto increment=[](uint32_t& n){if(n!=UINT32_MAX)++n;};
+    increment(packets);if(token)increment(eligible);
+    if(r.recognized){increment(recognized);if(!token)increment(disabled_markers);}
+    if(r.disposition==NopDisposition::CountMismatch||r.disposition==NopDisposition::Truncated)increment(malformed);
+  }
+  bool Admit(bool enabled) {return enabled&&lines<256?(++lines,true):false;}
+  void Swap(bool enabled) {if(enabled&&epoch!=UINT32_MAX)++epoch;}
+};
+inline void ResetAtSwap(Consumer& consumer,IngressDiagnostics& diagnostic,bool enabled) {
+  consumer.Reset();diagnostic.Swap(enabled);
+}
+
+struct Scene {uint32_t core=0,camera=0,car=0,graphics=0;uint64_t generation=0;};
+inline bool ExactContext(const Scene& scene,uint32_t core,uint32_t camera,uint32_t graphics) {
+  return scene.generation&&scene.core&&scene.camera&&scene.car&&scene.graphics&&
+         core==scene.core&&camera==scene.camera&&graphics==scene.graphics;
+}
+inline Phase CarPhase(const Scene& scene,uint32_t car,uint32_t parent) {
+  if(!scene.generation||!car||parent!=scene.core)return Phase::Unknown;
+  return car==scene.car?Phase::PlayerCar:Phase::OtherCar;
+}
+// Native48 is the last written dword; limit56 bounds available immediate slab.
+// Do not allocate/flush/extend a recording. If unavailable, emit nothing and
+// invalidate this host session. Ordinary native code still forwards unchanged.
+inline bool Capacity(uint32_t cursor,uint32_t limit,uint32_t bytes,bool recording) {
+  return !recording&&cursor&&!(cursor&3)&&!(limit&3)&&bytes&&!(bytes&3)&&
+         uint64_t(cursor)+bytes<=limit;
+}
+template<class IO> bool Emit(IO& io,const Record& r) {
+  uint32_t cursor=0,limit=0;bool recording=true;
+  if(!io.Writer(cursor,limit,recording)||!Capacity(cursor,limit,(kWords+1)*4,recording)||
+     !io.Writable(cursor+4,(kWords+1)*4))return false;
+  const auto words=Encode(r);
+  io.Store(cursor+4,kNop);
+  for(uint32_t i=0;i<kWords;++i)io.Store(cursor+8+i*4,words[i]);
+  io.Commit(cursor+(kWords+1)*4);return true;
+}
+template<class IO,class Forward> void ObserveAndForward(IO& io,Phase phase,Forward&& forward) {
+  struct Exit {IO& io;uint32_t serial;~Exit(){if(serial)io.End(serial);}};
+  const Exit exit{io,io.Begin(phase)};
+  forward(); // Even when recording is disabled or the marker cannot be emitted.
+}
+} // namespace fh1::provenance
diff --git a/include/rex/graphics/fh1_provenance_capture.h b/include/rex/graphics/fh1_provenance_capture.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_provenance_capture.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <rex/graphics/fh1_provenance.h>
+#include <cstdio>
+#include <string>
+namespace fh1::provenance {
+class MarkerCapture {
+ public:
+  bool consumed()const{return consumed_;}
+  bool TryStart(bool enabled,const char* path,const NopReceipt& receipt,
+                const Consumer& consumer,FILE*& file,uint32_t& draws,uint32_t& records) {
+    if(!enabled||consumed_||file||!path||!*path)return false;
+    const auto context=consumer.context();
+    if(!receipt.ok||!receipt.recognized||receipt.count!=kWords||
+       receipt.disposition!=NopDisposition::Consumed||
+       receipt.words[1]!=((kVersion<<16)|uint16_t(Op::FrameBegin))||
+       !consumer.eligible()||consumer.fault()||!context.valid||
+       context.token!=consumer.eligible()||context.token!=receipt.words[2]||
+       context.frame!=receipt.words[3])return false;
+    const std::string arm=std::string(path)+".marker-trigger";
+    FILE* trigger=std::fopen(arm.c_str(),"rb");if(!trigger)return false;
+    std::fclose(trigger);
+    FILE* opened=std::fopen(path,"wb");if(!opened)return false;
+    if(std::remove(arm.c_str())!=0){std::fclose(opened);return false;}
+    file=opened;consumed_=true;draws=0;records=0;
+    std::fprintf(file,"B provenance-start token=%u frame=%u\n",context.token,context.frame);
+    return true;
+  }
+ private:
+  bool consumed_=false;
+};
+// Same production M format and budget as before; shared with the file-backed
+// regression so first-record ordering is tested through actual trace code.
+inline bool TraceMarker(FILE* file,const Consumer& consumer,const NopReceipt& receipt,uint32_t& records) {
+  if(receipt.disposition!=NopDisposition::Consumed||!TraceAllowed(file!=nullptr,consumer.eligible(),records))return false;
+  const auto c=consumer.context();const auto& words=receipt.words;
+  std::fprintf(file,"M token=%u serial=%u op=%u phase=%u valid=%u fault=%u data=%08X,%08X,%08X,%08X,%08X\n",
+    words[2],words[3],words[1]&65535,words[4],c.valid,consumer.fault(),words[5],words[6],words[7],words[8],words[9]);
+  return true;
+}
+inline void CloseTraceAtSwap(FILE*& file,uint32_t draws) {
+  if(!file)return;
+  std::fprintf(file,"E frame end, %u draws\n",draws);
+  std::fclose(file);file=nullptr;
+}
+} // namespace fh1::provenance
diff --git a/include/rex/graphics/fh1_record_execution.h b/include/rex/graphics/fh1_record_execution.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_record_execution.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <array>
+#include <cstdint>
+namespace fh1::record_execution {
+struct Invocation {uint32_t ptr=0,words=0,call_packet=0;uint64_t id=0;};
+struct Location {
+  uint32_t kind=0,ptr=0,count=0,depth=0,parent=0,packet_phys=0;
+  uint64_t instance=0,parent_instance=0;std::array<Invocation,8> chain{};bool overflow=false;
+};
+inline Location Enter(const Location& saved,uint32_t kind,uint32_t ptr,uint32_t words,bool enabled,uint64_t& counter){
+  Location out;out.kind=kind;out.ptr=ptr;out.count=words;out.depth=kind==1?0:saved.depth+1;out.parent=saved.ptr;
+  if(!enabled)return out;
+  out.parent_instance=saved.instance;
+  if(counter==UINT64_MAX){out.overflow=true;return out;}
+  out.instance=++counter;if(kind!=1)out.chain=saved.chain;
+  out.overflow=saved.overflow||out.depth>=out.chain.size();
+  if(out.depth<out.chain.size())out.chain[out.depth]={ptr,words,saved.packet_phys,out.instance};
+  return out;
+}
+inline uint32_t Packet(const Location& location,uint32_t offset){
+  const auto physical=uint64_t(location.ptr&0x1FFFFFFFu)+offset;
+  return physical<0x20000000ull?uint32_t(physical):UINT32_MAX;
+}
+} // namespace fh1::record_execution
diff --git a/include/rex/graphics/fh1_recorded_capture.h b/include/rex/graphics/fh1_recorded_capture.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_recorded_capture.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <rex/graphics/fh1_recorded_provenance.h>
+#include <cstdio>
+#include <string>
+namespace fh1::recorded {
+class MarkerCapture {
+ public:
+  bool consumed()const{return consumed_;}bool checked()const{return checked_;}
+  bool TryStart(bool enabled,const char* path,const Receipt& receipt,const Consumer& consumer,FILE*& file,uint32_t& draws,uint32_t& records){
+    if(!enabled||checked_||file||!path||!*path)return false;
+    const auto c=consumer.context();
+    if(!receipt.recognized||!receipt.ok||receipt.count!=kWords||receipt.words[1]!=((kVersion<<16)|uint16_t(Op::FrameBegin))||!c.valid||consumer.fault()||!consumer.eligible()||c.uid!=consumer.eligible()||c.uid!=receipt.words[2]||c.frame!=receipt.words[3])return false;
+    // One lookup, at the first accepted recorded Begin. Never stat per NOP or
+    // fall through to a later frame when the prearm file was absent/failed.
+    checked_=true;const std::string arm=std::string(path)+".marker-trigger";
+    FILE* trigger=std::fopen(arm.c_str(),"rb");if(!trigger)return false;std::fclose(trigger);
+    FILE* opened=std::fopen(path,"wb");if(!opened)return false;
+    if(std::remove(arm.c_str())!=0){std::fclose(opened);return false;}
+    file=opened;consumed_=true;draws=0;records=0;
+    std::fprintf(file,"B recorded-start uid=%u frame=%u replay=%llu\n",c.uid,c.frame,(unsigned long long)c.replay);return true;
+  }
+ private:bool checked_=false,consumed_=false;
+};
+inline bool TraceMarker(FILE* file,const Receipt& receipt,const Consumer& consumer,uint32_t& records){
+  if(!file||records>=4096||!receipt.recognized)return false;++records;const auto& w=receipt.words;const auto c=consumer.context();
+  std::fprintf(file,"Q uid=%u frame=%u replay=%llu op=%u serial=%u phase=%u valid=%u fault=%u data=%08X,%08X,%08X,%08X,%08X\n",w[2],c.valid?c.frame:receipt.prior_frame,(unsigned long long)(c.valid?c.replay:receipt.prior_replay),w[1]&65535,w[3],w[4],c.valid,consumer.fault(),w[5],w[6],w[7],w[8],w[9]);return true;
+}
+}
diff --git a/include/rex/graphics/fh1_recorded_provenance.h b/include/rex/graphics/fh1_recorded_provenance.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/fh1_recorded_provenance.h
@@ -0,0 +1,123 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <span>
+#include <cstddef>
+// Include the existing provenance protocol first. Separate wire magic and
+// consumer: recorded replay never weakens the immediate protocol's serial rules.
