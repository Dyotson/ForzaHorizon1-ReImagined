+namespace fh1::partial {
+// A single registry string publishes the seal, its producer revision and the
+// identity captured by that producer. Empty is a hard revoke, never RecordStart.
+struct Admission {uint32_t uid=0,epoch=0;Identity source{};};
+inline Admission ParseAdmission(std::string_view text){
+  Admission out;const auto first=text.find(',');if(first==text.npos)return {};
+  auto number=[](std::string_view s,uint32_t& v){const auto p=std::from_chars(s.data(),s.data()+s.size(),v);return p.ec==std::errc{}&&p.ptr==s.data()+s.size()&&v;};
+  if(!number(text.substr(0,first),out.uid))return {};text.remove_prefix(first+1);
+  const auto second=text.find(',');if(second==text.npos||!number(text.substr(0,second),out.epoch))return {};
+  out.source=Parse(text.substr(second+1));if(!out.source.session)return {};return out;
+}
+class ReplayLease {
+ public:
+  uint32_t uid()const{return uid_;}uint32_t retired()const{return retired_;}
+  uint32_t pending()const{return pending_;}bool active()const{return uid_!=0;}
+  void Revoke(recorded::Consumer& consumer){
+    if(uid_>retired_)retired_=uid_;if(consumer.eligible()>retired_)retired_=consumer.eligible();
+    uid_=epoch_=pending_=0;source_={};consumer.Eligibility(0);consumer.Reset();
+  }
+  recorded::Consumer::EligibilityReceipt Refresh(recorded::Consumer& consumer,
+      bool requested,bool vr,const Admission& admission,const Identity& live,
+      uint32_t token,uint64_t now){
+    const bool hard=requested&&!vr&&admission.uid&&admission.epoch&&
+        Fresh(live,token,now)&&Same(admission.source,live);
+    if(!hard||consumer.fault()||(uid_&&(admission.epoch!=epoch_||
+        !Same(source_,live)||admission.uid<uid_||admission.uid<pending_))){
+      Revoke(consumer);return consumer.Eligibility(0);
+    }
+    pending_=admission.uid;
+    // Publication churn cannot replace the currently executing sealed record.
+    return consumer.Eligibility(uid_?uid_:(admission.uid>retired_?admission.uid:0));
+  }
+  bool Observe(recorded::Consumer& consumer,const recorded::Receipt& marker,
+      const Admission& admission,const Identity& live,uint32_t token,uint64_t now){
+    if(!marker.recognized)return false;
+    if(!marker.ok||consumer.fault()){Revoke(consumer);return false;}
+    if(uint16_t(marker.words[1])!=uint16_t(recorded::Op::FrameBegin))return active();
+    const auto c=consumer.context();
+    if(!c.valid||!Fresh(live,token,now)||!Same(admission.source,live)){
