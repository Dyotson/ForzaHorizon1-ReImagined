diff --git a/src/graphics/vulkan/fh1_native_geometry.cpp b/src/graphics/vulkan/fh1_native_geometry.cpp
new file mode 100644
index 0000000..6e85938
--- /dev/null
+++ b/src/graphics/vulkan/fh1_native_geometry.cpp
@@ -0,0 +1,128 @@
+#include <rex/graphics/vulkan/fh1_native_geometry.h>
+#include <rex/ui/vulkan/device.h>
+#include <rex/logging.h>
+#include <cstring>
+#include <stdexcept>
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+#include "geometry_pass.h"
+#include "fh1_native_geometry_shader.h"
+#include <algorithm>
+#include <atomic>
+#include <type_traits>
+#include <unordered_map>
+namespace rex::graphics::vulkan {
+namespace nr = forza::native_renderer;
+static_assert(std::is_trivially_copyable_v<nr::GeometryPass::Dispatch>);
+static_assert(sizeof(nr::GeometryPass::Dispatch) <= 512);
+static_assert(alignof(Fh1NativeGeometry::Packet) <= alignof(uintmax_t));
+struct Fh1NativeGeometry::State {
+  const ui::vulkan::VulkanDevice* device;
+  nr::GeometryVulkanDispatch functions;
+  struct Pool { std::unique_ptr<nr::GeometryPass> pass; uint32_t next = 0; };
+  std::unordered_map<uint64_t, Pool> pools;
+  std::vector<uint32_t> shader;
+  uint64_t prepared = 0;
+  std::atomic<uint64_t> executed{0};
+  bool failed = false;
+};
+Fh1NativeGeometry::Fh1NativeGeometry(const ui::vulkan::VulkanDevice* device)
+    : state_(std::make_unique<State>()) {
+  state_->device = device;
+  auto load = [&](const char* name) {
+    const auto& instance = *device->vulkan_instance();
+    return std::string_view(name).starts_with("vkGetPhysicalDevice") ?
+        instance.functions().vkGetInstanceProcAddr(instance.instance(), name) :
+        instance.functions().vkGetDeviceProcAddr(device->device(), name);
+  };
+#define FH1_GEOMETRY_LOAD(name) state_->functions.name = reinterpret_cast<PFN_##name>(load(#name));
+  FORZA_NATIVE_VULKAN_FUNCTIONS(FH1_GEOMETRY_LOAD)
+  FORZA_NATIVE_GEOMETRY_VULKAN_FUNCTIONS(FH1_GEOMETRY_LOAD)
+#undef FH1_GEOMETRY_LOAD
+  if (!state_->functions.Valid()) throw std::runtime_error("Native geometry functions unavailable");
+  std::string error;
+  if (!CompileFh1Vertex(kFh1NativeGeometrySource, state_->shader, error))
+    throw std::runtime_error("Native geometry shader: " + error);
+}
+Fh1NativeGeometry::~Fh1NativeGeometry() = default;
+std::optional<Fh1NativeGeometry::Packet> Fh1NativeGeometry::Prepare(
+    VkRenderPass render_pass, const Source& source, uint64_t submission, uint64_t completed) {
+  auto& state = *state_;
+  constexpr uint32_t kSlots = 64, kMaxBytes = 256 * 1024;
+  if (state.failed || !render_pass || !source.vertex_bytes || !source.index_bytes ||
+      source.vertex_bytes > kMaxBytes || source.index_bytes > kMaxBytes - 4 ||
+      source.vertex_bytes % 28 || source.index_bytes % 2) return {};
+  nr::GeometryParameters p;
+  std::memcpy(p.clip_columns.data(), source.constants.data(), 64);
+  std::memcpy(p.origin_scale.data(), source.constants.data() + 16, 16);
+  std::copy(source.ndc_scale.begin(), source.ndc_scale.end(), p.ndc_scale.begin());
+  std::copy(source.ndc_offset.begin(), source.ndc_offset.end(), p.ndc_offset.begin());
+  p.layout = {7, source.vertex_endian, source.vertex_bytes / 28, source.index_endian};
+  if (!nr::Valid(p)) return {};
+  nr::GeometryPass::GpuMesh mesh;
+  mesh.vertices = {source.buffer, source.buffer_bytes, source.vertex_offset, source.vertex_bytes};
+  mesh.indices = {source.buffer, source.buffer_bytes, source.index_offset, source.index_bytes};
+  nr::GeometryPass::Raster raster{source.viewport, source.scissor, source.stencil_reference};
+  try {
+    // Four fixed size classes bound memory and prevent menu-only mesh sizes
+    // from exhausting the pool cache before a race starts.
+    const uint32_t bytes = std::max(source.vertex_bytes, source.index_bytes + 4);
+    const uint32_t capacity = bytes <= 4096 ? 4096 : bytes <= 16384 ? 16384 : bytes <= 65536 ? 65536 : kMaxBytes;
+    const uint64_t key = (uint64_t(source.dynamic_rendering) << 32) | capacity;
+    auto found = state.pools.find(key);
+    if (found == state.pools.end()) {
+      // All callers guarantee the same single-sample, D32S8-only compatibility
+      // class. Pipeline creation doesn't retain its original render-pass handle.
+      if (state.pools.size() >= 8) return {};
+      State::Pool pool;
+      pool.pass = std::make_unique<nr::GeometryPass>();
+      nr::GeometryPass::Config config;
+      config.render_pass = render_pass; config.slots = kSlots;
+      config.dynamic_rendering = source.dynamic_rendering;
+      config.vertex_capacity = config.index_capacity = capacity;
+      pool.pass->Initialize(state.functions, state.device->physical_device(), state.device->device(), config, state.shader);
+      found = state.pools.emplace(key, std::move(pool)).first;
+    }
+    auto& pool = found->second;
+    for (uint32_t attempt = 0; attempt < kSlots; ++attempt) {
+      const uint32_t slot = (pool.next + attempt) % kSlots;
+      const auto draw = pool.pass->PrepareGpu(slot, mesh, p, raster, submission, completed);
+      if (!draw) continue;
+      pool.next = (slot + 1) % kSlots;
+      Packet packet; packet.owner = this; packet.pass = pool.pass.get();
+      std::memcpy(packet.token.data(), &*draw, sizeof(*draw));
+      if (++state.prepared == 1 || state.prepared % 120 == 0)
+        REXGPU_INFO("FH1 native geometry: prepared rigid depth draw {} ({} indices, submission {}, completed {})",
+            state.prepared, source.index_bytes / 2, submission, completed);
+      return packet;
+    }
+  } catch (const std::exception& error) {
+    state.failed = true;
+    REXGPU_ERROR("FH1 native geometry disabled; original draws retained: {}", error.what());
+  }
+  return {};
+}
+void Fh1NativeGeometry::RecordUploads(VkCommandBuffer command, const Packet& packet) {
+  nr::GeometryPass::Dispatch draw;
+  std::memcpy(&draw, packet.token.data(), sizeof(draw));
+  static_cast<const nr::GeometryPass*>(packet.pass)->RecordUploads(command, draw);
+}
+void Fh1NativeGeometry::Record(VkCommandBuffer command, const Packet& packet) {
+  nr::GeometryPass::Dispatch draw;
+  std::memcpy(&draw, packet.token.data(), sizeof(draw));
+  static_cast<const nr::GeometryPass*>(packet.pass)->Record(command, draw);
+  if (packet.owner->state_->executed.fetch_add(1) == 0)
+    REXGPU_INFO("FH1 native geometry: GPU snapshots and authored rigid depth draw executed on submission thread");
+}
+}
+#else
+namespace rex::graphics::vulkan {
+struct Fh1NativeGeometry::State {};
+Fh1NativeGeometry::Fh1NativeGeometry(const ui::vulkan::VulkanDevice*) {
+  throw std::runtime_error("Native geometry not built; set REXGLUE_FH1_NATIVE_SOURCE_DIR");
+}
+Fh1NativeGeometry::~Fh1NativeGeometry() = default;
+std::optional<Fh1NativeGeometry::Packet> Fh1NativeGeometry::Prepare(VkRenderPass, const Source&, uint64_t, uint64_t) { return {}; }
+void Fh1NativeGeometry::RecordUploads(VkCommandBuffer, const Packet&) {}
+void Fh1NativeGeometry::Record(VkCommandBuffer, const Packet&) {}
+}
+#endif
