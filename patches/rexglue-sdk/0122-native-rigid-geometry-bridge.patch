+    uint32_t vertex_endian = 0, index_endian = 0;
+    std::array<float, 20> constants{};
+    std::array<float, 3> ndc_scale{}, ndc_offset{};
+    VkViewport viewport{};
+    VkRect2D scissor{};
+    uint32_t stencil_reference = 0;
+  };
+  explicit Fh1NativeGeometry(const ui::vulkan::VulkanDevice*);
+  ~Fh1NativeGeometry();
+  std::optional<Packet> Prepare(VkRenderPass, const Source&, uint64_t submission, uint64_t completed);
+  static void RecordUploads(VkCommandBuffer, const Packet&);
+  static void Record(VkCommandBuffer, const Packet&);
+ private:
+  struct State;
+  std::unique_ptr<State> state_;
+};
+}
