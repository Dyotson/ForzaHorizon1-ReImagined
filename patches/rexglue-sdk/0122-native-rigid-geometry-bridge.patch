+class Fh1NativeGeometry {
+ public:
+  // DeferredCommandBuffer stores eight-byte words. Keep this envelope aligned
+  // to those words and memcpy its opaque payload into an aligned local token.
+  struct Packet {
+    const Fh1NativeGeometry* owner = nullptr;
+    const void* pass = nullptr;
