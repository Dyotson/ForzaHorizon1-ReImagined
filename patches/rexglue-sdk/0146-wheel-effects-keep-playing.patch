+/**
+ * @file        src/input/wheel/wheel_ff_keep_playing.h
+ * @brief       Keeping the wheel's effects playing where SDL cannot make them endless (#304),
+ *              without SDL.
+ *
+ * Every effect the driver plays has SDL's endless length (SDL_HAPTIC_INFINITY, 0xFFFFFFFF ms) and
+ * is started for ever. SDL's Linux backend sends that as an endless effect, but its DirectInput
+ * (Windows) and ForceFeedback (macOS) backends multiply the length by 1000 in 32 bits
+ * (`length * 1000UL`, SDL 3.4.14 and SDL's main branch): the effect gets 4294966296 us, about 71
+ * minutes, never INFINITE (0xFFFFFFFF). A HID PID wheel's duration field holds 16 bits of
+ * milliseconds (32.767 s or 65.535 s at most), so the system's PID driver cannot pass 71 minutes
+ * on: a Simagic Alpha EVO Pro on Windows ended the game's steering force, spring and damper about
+ * 30 s after each start, leaving the base's own centring, until a pause started them again (the
+ * forces back at full strength restart every effect, SDK patch 0130).
+ *
+ * So where SDL's lengths are finite the driver starts every effect it plays again every few
+ * seconds (starting a playing effect restarts it, with the same parameters), well inside that
+ * limit. `wheel_ffb_keep_playing` sets the interval: -1 (default) 5 s on Windows and macOS and
+ * never on Linux, 0 never, N every N seconds.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::input::wheel {
+
+#if defined(_WIN32) || defined(__APPLE__)
+constexpr bool kSdlEffectLengthsFinite = true;
+#else
+constexpr bool kSdlEffectLengthsFinite = false;
+#endif
+constexpr int kFfKeepPlayingSeconds = 5;
+
+// The duration SDL's DirectInput and macOS backends give an effect of `length_ms` (32 bits, as
+// `length * 1000UL` is with Windows' 32-bit unsigned long).
+constexpr uint32_t SdlBackendDurationUs(uint32_t length_ms) {
+  return static_cast<uint32_t>(length_ms * 1000u);
+}
+
+// The restart interval in seconds for the wheel_ffb_keep_playing setting; 0: never.
+constexpr int FfKeepPlayingSeconds(int setting, bool sdl_lengths_finite = kSdlEffectLengthsFinite) {
+  return setting < 0 ? (sdl_lengths_finite ? kFfKeepPlayingSeconds : 0) : setting;
+}
+
+// When the effects are next started again: `last` is when they last were (or when the wheel was
+// opened), all in seconds.
+constexpr bool FfKeepPlayingDue(double last, double now, int seconds) {
+  return seconds > 0 && now - last >= seconds;
+}
+
+}  // namespace rex::input::wheel
