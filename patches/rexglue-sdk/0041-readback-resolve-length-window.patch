+bool CommandProcessor::ShouldReadbackResolve(uint32_t written_length) const {
+  int32_t min_length = REXCVAR_GET(readback_resolve_min_length);
+  int32_t max_length = REXCVAR_GET(readback_resolve_max_length);
+  return written_length >= uint32_t(std::max(min_length, 0)) &&
+         (max_length <= 0 || written_length <= uint32_t(max_length));
+}
