+bool VulkanRenderTargetCache::QueueNativeVelocity(Fh1NativeRenderer& renderer,
+    VkImageView depth, const float* constants, uint32_t width, uint32_t height, bool replace) {
+  auto* target = static_cast<VulkanRenderTarget*>(last_update_accumulated_render_targets()[1]);
+  if (GetPath() != Path::kHostRenderTargets || !target ||
+      target->key().msaa_samples != xenos::MsaaSamples::k1X ||
+      GetColorVulkanFormat(target->key().GetColorFormat()) != VK_FORMAT_R8G8B8A8_UNORM ||
+      !last_update_framebuffer_ || width > last_update_framebuffer_->host_extent.width ||
+      height > last_update_framebuffer_->host_extent.height ||
+      (replace && UsesFractionalRaster())) return false;
+  auto packet = renderer.PrepareVelocity(depth, constants, width, height,
+      command_processor_.GetCurrentSubmission(), command_processor_.GetCompletedSubmission());
+  if (!packet) return false;
+  command_processor_.EndRenderPass();
+  const auto range = ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT);
+  if (replace) {
+    packet->destination = target->image();
+    command_processor_.PushImageMemoryBarrier(target->image(), range, target->current_stage_mask(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, target->current_access_mask(), VK_ACCESS_TRANSFER_WRITE_BIT,
+        target->current_layout(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    target->SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  }
+  command_processor_.SubmitBarriers(true);
+  command_processor_.deferred_command_buffer().CmdFh1NativeVelocity(*packet);
+  command_processor_.Fh1InvalidateBindings();
+  if (replace) {
+    command_processor_.PushImageMemoryBarrier(target->image(), range, target->current_stage_mask(),
+        VulkanRenderTarget::kColorDrawStageMask, target->current_access_mask(),
+        VulkanRenderTarget::kColorDrawAccessMask, target->current_layout(), VulkanRenderTarget::kColorDrawLayout);
+    target->SetUsage(VulkanRenderTarget::kColorDrawStageMask, VulkanRenderTarget::kColorDrawAccessMask,
+        VulkanRenderTarget::kColorDrawLayout);
+    static uint64_t replacements = 0;
+    if (++replacements == 1 || replacements % 120 == 0)
+      REXGPU_INFO("FH1 native renderer: replaced velocity draw {} ({}x{}), native HUD retained",
+          replacements, width, height);
+  }
+  return true;
+}
+
 }  // namespace rex::graphics::vulkan
