--- /dev/null
+++ b/cmake/ForzaNative.cmake
@@ -0,0 +1,20 @@
+# The canonical implementation is maintained and tested by the FH1 project.
+# Leave empty for a standalone SDK build with the original renderer only.
+set(REXGLUE_FH1_NATIVE_SOURCE_DIR "" CACHE PATH "FH1 native renderer source directory")
+target_sources(rexgpu-xenos PRIVATE vulkan/fh1_native_renderer.cpp)
+if(REXGLUE_FH1_NATIVE_SOURCE_DIR)
+    foreach(source velocity.h velocity_pass.h velocity_pass.cpp vulkan_dispatch.h velocity.comp)
+        if(NOT EXISTS "${REXGLUE_FH1_NATIVE_SOURCE_DIR}/${source}")
+            message(FATAL_ERROR "Missing native renderer source: ${REXGLUE_FH1_NATIVE_SOURCE_DIR}/${source}")
+        endif()
+    endforeach()
+    file(READ "${REXGLUE_FH1_NATIVE_SOURCE_DIR}/velocity.comp" FH1_NATIVE_VELOCITY_SOURCE)
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+        "${REXGLUE_FH1_NATIVE_SOURCE_DIR}/velocity.comp")
+    configure_file("${CMAKE_CURRENT_LIST_DIR}/fh1_native_shader.h.in"
+        "${CMAKE_CURRENT_BINARY_DIR}/fh1_native_shader.h" @ONLY)
+    target_sources(rexgpu-xenos PRIVATE "${REXGLUE_FH1_NATIVE_SOURCE_DIR}/velocity_pass.cpp")
+    target_include_directories(rexgpu-xenos PRIVATE
+        "${REXGLUE_FH1_NATIVE_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}")
+    target_compile_definitions(rexgpu-xenos PRIVATE REXGLUE_FH1_NATIVE_RENDERER=1)
+endif()
