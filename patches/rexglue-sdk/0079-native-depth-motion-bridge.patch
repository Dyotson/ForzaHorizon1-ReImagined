diff --git a/src/graphics/vulkan/fh1_native_renderer.cpp b/src/graphics/vulkan/fh1_native_renderer.cpp
new file mode 100644
--- /dev/null
+++ b/src/graphics/vulkan/fh1_native_renderer.cpp
@@ -0,0 +1,160 @@
+#include <rex/graphics/vulkan/fh1_native_renderer.h>
+#include <rex/graphics/vulkan/fh1_dlss.h>
+#include <rex/ui/vulkan/device.h>
+#include <rex/logging.h>
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+#include "velocity_pass.h"
+#include "fh1_native_shader.h"
+#include <unordered_map>
+#include <atomic>
+#include <cstring>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+namespace nr = forza::native_renderer;
+struct Fh1NativeRenderer::State {
+  const ui::vulkan::VulkanDevice* device;
+  nr::VulkanDispatch functions;
+  PFN_vkCmdCopyImage copy = nullptr;
+  struct Extent { std::unique_ptr<nr::VelocityPass> pass; uint32_t next = 0; };
+  std::unordered_map<uint64_t, Extent> extents;
+  std::vector<uint32_t> shader;
+  uint64_t prepared = 0;
+  std::atomic<uint64_t> executed{0};
+  bool failed = false, invalid_logged = false;
+};
+Fh1NativeRenderer::Fh1NativeRenderer(const ui::vulkan::VulkanDevice* device)
+    : state_(std::make_unique<State>()) {
+  state_->device = device;
+  auto load = [&](const char* name) {
+    const auto& instance = *device->vulkan_instance();
+    return std::string_view(name).substr(0, 19) == "vkGetPhysicalDevice" ?
+        instance.functions().vkGetInstanceProcAddr(instance.instance(), name) :
+        instance.functions().vkGetDeviceProcAddr(device->device(), name);
+  };
+#define FH1_NATIVE_LOAD(name) state_->functions.name = reinterpret_cast<PFN_##name>(load(#name));
+  FORZA_NATIVE_VULKAN_FUNCTIONS(FH1_NATIVE_LOAD)
+#undef FH1_NATIVE_LOAD
+  if (!state_->functions.Valid()) throw std::runtime_error("Native renderer Vulkan functions unavailable");
+  state_->copy = reinterpret_cast<PFN_vkCmdCopyImage>(device->vulkan_instance()->functions()
+      .vkGetDeviceProcAddr(device->device(), "vkCmdCopyImage"));
+  if (!state_->copy) throw std::runtime_error("Native renderer image transfer unavailable");
+  std::string error;
+  if (!CompileFh1Compute(kFh1NativeVelocitySource, state_->shader, error))
+    throw std::runtime_error("Native velocity shader: " + error);
+  REXGPU_INFO("FH1 native renderer initialized; mode={}", std::getenv("FORZA_NATIVE_RENDERER"));
+}
+Fh1NativeRenderer::~Fh1NativeRenderer() = default;
+
+std::optional<Fh1NativeRenderer::Packet> Fh1NativeRenderer::PrepareVelocity(
+    VkImageView depth, const float* constants, uint32_t width, uint32_t height,
+    uint64_t submission, uint64_t completed) {
+  auto& state = *state_;
+  if (state.failed || !depth || !constants || !width || !height || width > 8192 || height > 4320) return {};
+  nr::VelocityParameters parameters;
+  std::memcpy(parameters.previous.data(), constants + 32 * 4, sizeof(parameters.previous));
+  parameters.projection = {constants[132 * 4], constants[132 * 4 + 1], 0, 0};
+  parameters.blur = {constants[133 * 4 + 1], constants[133 * 4 + 2], constants[133 * 4 + 3], constants[255 * 4 + 3]};
+  if (!nr::Valid(parameters)) {
+    if (!state.invalid_logged) {
+      state.invalid_logged = true;
+      REXGPU_INFO("FH1 native velocity: invalid pass controls; original draw retained");
+    }
+    return {};
+  }
+  try {
+    const uint64_t key = (uint64_t(width) << 32) | height;
+    auto found = state.extents.find(key);
+    if (found == state.extents.end()) {
+      if (state.extents.size() >= 4) return {};
+      State::Extent extent;
+      extent.pass = std::make_unique<nr::VelocityPass>();
+      extent.pass->Initialize(state.functions, state.device->physical_device(), state.device->device(),
+          width, height, 3, state.shader);
+      found = state.extents.emplace(key, std::move(extent)).first;
+      const auto name_object = reinterpret_cast<PFN_vkSetDebugUtilsObjectNameEXT>(
+          state.device->vulkan_instance()->functions().vkGetDeviceProcAddr(
+              state.device->device(), "vkSetDebugUtilsObjectNameEXT"));
+      if (name_object) {
+        const char* attachments[] = {"depth", "motion", "blur"};
+        for (uint32_t slot = 0; slot < 3; ++slot) for (uint32_t image = 0; image < 3; ++image) {
+          const auto handle = found->second.pass->output(slot, image).image;
+          std::string name = "FH1 Native " + std::string(attachments[image]) + " " + std::to_string(slot);
+          VkDebugUtilsObjectNameInfoEXT info{VK_STRUCTURE_TYPE_DEBUG_UTILS_OBJECT_NAME_INFO_EXT};
+          info.objectType = VK_OBJECT_TYPE_IMAGE;
+          std::memcpy(&info.objectHandle, &handle, sizeof(handle));
+          info.pObjectName = name.c_str();
+          name_object(state.device->device(), &info);
+        }
+      }
+    }
+    auto& extent = found->second;
+    for (uint32_t attempt = 0; attempt < 3; ++attempt) {
+      const uint32_t slot = (extent.next + attempt) % 3;
+      const auto dispatch = extent.pass->Prepare(slot, depth, parameters, submission, completed);
+      if (!dispatch) continue;
+      extent.next = (slot + 1) % 3;
+      Packet packet;
+      packet.owner = this; packet.pass = extent.pass.get();
+      packet.descriptors = dispatch->descriptors; packet.images = dispatch->images;
+      packet.width = width; packet.height = height; packet.first_use = dispatch->first_use;
+      if (++state.prepared == 1 || state.prepared % 120 == 0)
+        REXGPU_INFO("FH1 native velocity: prepared {}x{} (submission {}, completed {}, pass {})",
+            width, height, submission, completed, state.prepared);
+      return packet;
+    }
+  } catch (const std::exception& error) {
+    state.failed = true;
+    REXGPU_ERROR("FH1 native renderer disabled; original rendering retained: {}", error.what());
+  }
+  return {};
+}
+
+void Fh1NativeRenderer::Record(VkCommandBuffer command, const Packet& packet) {
+  auto& state = *packet.owner->state_;
+  auto& functions = state.device->functions();
+  // Imported texture-cache images are tracked as graphics reads. These full
+  // queue dependencies also order compute reads before later cache overwrites.
+  VkMemoryBarrier imported{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+  imported.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+  imported.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  functions.vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &imported, 0, nullptr, 0, nullptr);
+  nr::VelocityPass::Dispatch dispatch;
+  dispatch.descriptors = packet.descriptors; dispatch.images = packet.images;
+  dispatch.first_use = packet.first_use;
+  static_cast<const nr::VelocityPass*>(packet.pass)->Record(command, dispatch);
+  if (packet.destination) {
+    VkImageCopy copy{};
+    copy.srcSubresource = copy.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.extent = {packet.width, packet.height, 1};
+    state.copy(command, packet.images[2], VK_IMAGE_LAYOUT_GENERAL, packet.destination,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+  }
+  imported.srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+      VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+  imported.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+  functions.vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &imported, 0, nullptr, 0, nullptr);
+  if (state.executed.fetch_add(1) == 0)
+    REXGPU_INFO("FH1 native renderer: native depth/motion/blur dispatch executed on the submission thread");
+}
+}
+
+#else
+#include <stdexcept>
+namespace rex::graphics::vulkan {
+struct Fh1NativeRenderer::State {};
+Fh1NativeRenderer::Fh1NativeRenderer(const ui::vulkan::VulkanDevice*) {
+  throw std::runtime_error("Native renderer not built; set REXGLUE_FH1_NATIVE_SOURCE_DIR");
+}
+Fh1NativeRenderer::~Fh1NativeRenderer() = default;
+std::optional<Fh1NativeRenderer::Packet> Fh1NativeRenderer::PrepareVelocity(
+    VkImageView, const float*, uint32_t, uint32_t, uint64_t, uint64_t) { return {}; }
+void Fh1NativeRenderer::Record(VkCommandBuffer, const Packet&) {}
+}  // namespace rex::graphics::vulkan
+#endif
