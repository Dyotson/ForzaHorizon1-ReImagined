@@ -0,0 +1,30 @@
+#pragma once
+#include <array>
+#include <memory>
+#include <optional>
+#include <rex/ui/vulkan/api.h>
+namespace rex::ui::vulkan { class VulkanDevice; }
+namespace rex::graphics::vulkan {
+class Fh1NativeRenderer {
+ public:
+  // Immutable producer snapshot. The owner and pass outlive GPU completion;
+  // ShutdownContext drains recording and submission work before releasing them.
+  struct Packet {
+    const Fh1NativeRenderer* owner = nullptr;
+    const void* pass = nullptr;
+    VkDescriptorSet descriptors = VK_NULL_HANDLE;
+    VkImage destination = VK_NULL_HANDLE;
+    std::array<VkImage, 3> images{};
+    uint32_t width = 0, height = 0;
+    bool first_use = false;
+  };
+  explicit Fh1NativeRenderer(const ui::vulkan::VulkanDevice* device);
+  ~Fh1NativeRenderer();
+  std::optional<Packet> PrepareVelocity(VkImageView depth, const float* constants,
+      uint32_t width, uint32_t height, uint64_t submission, uint64_t completed);
+  static void Record(VkCommandBuffer command, const Packet& packet);
+ private:
+  struct State;
+  std::unique_ptr<State> state_;
+};
+}
