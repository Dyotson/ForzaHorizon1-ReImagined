+void NoteFfFailure(int& failures, const char* what, uint32_t block) {
+  const int n = ++failures;
+  for (int k = 1; k > 0 && k <= n; k *= 10) {
+    if (k == n) {
+      REXLOG_WARN("Wheel: {} of the game's effect block {} failed ({} so far): {}", what, block, n,
+                  SDL_GetError());
+      return;
+    }
+  }
