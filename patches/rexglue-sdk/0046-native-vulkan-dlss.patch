+# NVIDIA NGX headers and static loader, pinned to the public DLSS SDK.
+# NVIDIA SDK terms apply; the license is staged beside the linked GPU library.
+set(_fh1_dlss_revision "374959484e79a640feaba44c93ac8cfb0a03f5b5")
+set(_fh1_dlss_base "https://raw.githubusercontent.com/NVIDIA/DLSS/${_fh1_dlss_revision}")
+if(NOT REXGLUE_DLSS_SDK)
+    set(REXGLUE_DLSS_SDK "${CMAKE_BINARY_DIR}/_deps/nvidia-dlss-${_fh1_dlss_revision}")
+    function(_fh1_dlss_asset relative expected_hash)
+        set(destination "${REXGLUE_DLSS_SDK}/${relative}")
+        if(EXISTS "${destination}")
+            file(SHA256 "${destination}" actual_hash)
+            if(actual_hash STREQUAL expected_hash)
+                return()
+            endif()
+        endif()
+        get_filename_component(parent "${destination}" DIRECTORY)
+        file(MAKE_DIRECTORY "${parent}")
+        message(STATUS "Fetching pinned NVIDIA DLSS SDK: ${relative}")
+        file(DOWNLOAD "${_fh1_dlss_base}/${relative}" "${destination}.download"
+             EXPECTED_HASH "SHA256=${expected_hash}" TLS_VERIFY ON
+             TIMEOUT 180 STATUS download_status)
+        list(GET download_status 0 download_code)
+        if(NOT download_code EQUAL 0)
+            message(FATAL_ERROR "NVIDIA DLSS SDK download failed: ${download_status}. Retry with network access, set REXGLUE_DLSS_SDK to a local SDK, or disable REXGLUE_USE_DLSS.")
+        endif()
+        file(RENAME "${destination}.download" "${destination}")
+    endfunction()
