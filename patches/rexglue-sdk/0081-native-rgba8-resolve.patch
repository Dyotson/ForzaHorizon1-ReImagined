+
+bool VulkanRenderTargetCache::TryNativeRgba8Resolve(VulkanRenderTarget* source,
+    uint32_t width, uint32_t height, const draw_util::ResolveInfo& info,
+    VulkanSharedMemory& shared_memory, VulkanTextureCache& texture_cache) {
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+  const char* mode = std::getenv("FORZA_NATIVE_RENDERER");
+  if (!mode || std::string_view(mode) != "velocity-resolve" || !source || native_resolve_failed_ ||
+      GetPath() != Path::kHostRenderTargets || info.IsCopyingDepth() ||
+      info.color_edram_info.format != uint32_t(xenos::ColorRenderTargetFormat::k_8_8_8_8) ||
+      info.color_edram_info.msaa_samples != xenos::MsaaSamples::k1X ||
+      info.color_edram_info.fill_half_pixel_offset || info.coordinate_info.edram_offset_x_div_8 ||
+      info.coordinate_info.edram_offset_y_div_8 || info.color_edram_info.base_tiles != info.color_original_base ||
+      source->key().base_tiles != info.color_original_base ||
+      source->key().GetPitchTiles() != info.color_edram_info.pitch_tiles ||
+      info.copy_dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 ||
+      info.copy_dest_info.copy_dest_number != xenos::SurfaceNumberFormat::kUnsignedRepeatingFraction ||
+      info.copy_dest_info.copy_dest_exp_bias || info.copy_dest_info.copy_dest_array ||
+      info.copy_dest_coordinate_info.copy_sample_select != xenos::CopySampleSelect::k0 ||
+      source->key().msaa_samples != xenos::MsaaSamples::k1X || UsesFractionalRaster()) return false;
+  const uint32_t sx = draw_resolution_scale_x(), sy = draw_resolution_scale_y();
+  if ((info.coordinate_info.width_div_8 * 8 * sx) != width || (info.height_div_8 * 8 * sy) != height)
+    return false;
+  uint64_t base = info.copy_dest_base;
+  uint64_t length = uint64_t(info.copy_dest_extent_start) - info.copy_dest_base + info.copy_dest_extent_length;
+  uint64_t use_start = info.copy_dest_extent_start, use_length = info.copy_dest_extent_length;
+  if (IsDrawResolutionScaled() &&
+      (!texture_cache.GetScaledResolveRange(info.copy_dest_base, uint32_t(length), 4, base, length) ||
+       !texture_cache.GetScaledResolveRange(info.copy_dest_extent_start, info.copy_dest_extent_length,
+                                           4, use_start, use_length))) return false;
+  const auto* device = command_processor_.GetVulkanDevice();
+  if (length > UINT32_MAX || length > device->properties().maxStorageBufferRange ||
+      base % device->properties().minStorageBufferOffsetAlignment) return false;
+  forza::native_renderer::ResolveParameters parameters;
+  parameters.source = {0, 0, width, height};
+  parameters.destination = {info.copy_dest_coordinate_info.offset_x_div_8 * 8u,
+      info.copy_dest_coordinate_info.offset_y_div_8 * 8u,
+      info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32u, 0};
+  parameters.layout = {sx, sy, uint32_t(info.copy_dest_info.copy_dest_endian), info.copy_dest_info.copy_dest_swap};
+  parameters.bounds = {uint32_t(length), source->key().GetWidth() * sx,
+      GetRenderTargetHeight(source->key().pitch_tiles_at_32bpp, source->key().msaa_samples) * sy, 0};
+  if (!forza::native_renderer::Valid(parameters)) return false;
+
+  // Create the native pipeline before queuing any resource transitions. Failure
+  // leaves the ordinary resolve path available, including its CPU readbacks.
+  const auto& functions = device->functions();
+  if (!native_resolve_pipeline_) {
+    std::vector<uint32_t> shader; std::string error;
+    if (!CompileFh1Compute(kFh1NativeResolveSource, shader, error)) {
+      native_resolve_failed_ = true;
+      REXGPU_ERROR("FH1 native resolve disabled: {}", error); return false;
+    }
+    VkDescriptorSetLayout layouts[] = {command_processor_.GetSingleTransientDescriptorLayout(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+        descriptor_set_layout_sampled_image_};
+    VkPushConstantRange range{VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(parameters)};
+    VkPipelineLayoutCreateInfo layout{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    layout.setLayoutCount = 2; layout.pSetLayouts = layouts;
+    layout.pushConstantRangeCount = 1; layout.pPushConstantRanges = &range;
+    if (functions.vkCreatePipelineLayout(device->device(), &layout, nullptr, &native_resolve_layout_) != VK_SUCCESS) {
+      native_resolve_layout_ = VK_NULL_HANDLE; native_resolve_failed_ = true; return false;
+    }
+    native_resolve_pipeline_ = ui::vulkan::util::CreateComputePipeline(device, native_resolve_layout_,
+        shader.data(), shader.size() * sizeof(uint32_t));
+    if (!native_resolve_pipeline_) { native_resolve_failed_ = true; return false; }
+  }
+  const uint32_t unscaled_length = info.copy_dest_extent_start - info.copy_dest_base + info.copy_dest_extent_length;
+  if (IsDrawResolutionScaled() ? !texture_cache.CommitScaledResolveRange(info.copy_dest_base, unscaled_length, 4) :
+      !shared_memory.RequestRange(info.copy_dest_extent_start, info.copy_dest_extent_length)) return false;
+  auto destination = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (!destination) return false;
+  VkDescriptorBufferInfo buffer{IsDrawResolutionScaled() ? texture_cache.scaled_resolve_buffer() : shared_memory.buffer(),
+      base, length};
+  VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  write.dstSet = destination; write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; write.pBufferInfo = &buffer;
+  functions.vkUpdateDescriptorSets(device->device(), 1, &write, 0, nullptr);
+  command_processor_.EndRenderPass();
+  if (IsDrawResolutionScaled()) texture_cache.UseScaledResolveBufferForWrite(use_start, use_length);
+  else shared_memory.Use(VulkanSharedMemory::Usage::kComputeWrite,
+      std::pair<uint32_t,uint32_t>(uint32_t(use_start), uint32_t(use_length)));
+  command_processor_.PushImageMemoryBarrier(source->image(),
+      ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT), source->current_stage_mask(),
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, source->current_access_mask(), VK_ACCESS_SHADER_READ_BIT,
+      source->current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  source->SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  command_processor_.BindExternalComputePipeline(native_resolve_pipeline_);
+  VkDescriptorSet descriptors[] = {destination, source->GetDescriptorSetTransferSource()};
+  auto& commands = command_processor_.deferred_command_buffer();
+  commands.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, native_resolve_layout_, 0, 2, descriptors, 0, nullptr);
+  commands.CmdVkPushConstants(native_resolve_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(parameters), &parameters);
+  command_processor_.SubmitBarriers(true);
+  commands.CmdVkDispatch((width / 4 + 7) / 8, (height + 7) / 8, 1);
+  texture_cache.MarkRangeAsResolved(info.copy_dest_extent_start, info.copy_dest_extent_length);
+  static uint64_t resolves = 0;
+  if (++resolves == 1 || resolves % 120 == 0)
+    REXGPU_INFO("FH1 native resolve: image to tiled buffer {} ({}x{}, scale {}x{})", resolves, width, height, sx, sy);
+  return true;
+#else
+  (void)source; (void)width; (void)height; (void)info; (void)shared_memory; (void)texture_cache;
+  return false;
+#endif
+}
