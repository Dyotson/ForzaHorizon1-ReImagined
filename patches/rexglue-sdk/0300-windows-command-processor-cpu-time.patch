+// FH1 (#400): the command processor's CPU time on Windows. QueryThreadCycleTime counts a
+// thread's time in cycles of the time stamp counter, which runs at a fixed rate (GetThreadTimes
+// only advances in scheduler ticks of about 15.6 ms, too coarse for a frame); the rate comes
+// from two samples of the time stamp counter and QueryPerformanceCounter. Cycles per ms, 0 when
+// the samples cannot tell (no time passed, a counter went back): the CPU time is then unknown.
+inline double CyclesPerMs(uint64_t tsc_first, uint64_t tsc_last, int64_t qpc_first,
+                          int64_t qpc_last, int64_t qpc_frequency) {
+  if (qpc_frequency <= 0 || qpc_last <= qpc_first || tsc_last <= tsc_first) return 0;
+  const double ms = double(qpc_last - qpc_first) * 1000.0 / double(qpc_frequency);
+  return double(tsc_last - tsc_first) / ms;
+}
+inline double CyclesToMs(uint64_t cycles, double cycles_per_ms) {
+  return cycles_per_ms > 0 ? double(cycles) / cycles_per_ms : 0;
+}
+
