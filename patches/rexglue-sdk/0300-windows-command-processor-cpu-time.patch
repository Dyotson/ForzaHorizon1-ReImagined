diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 7a376f8..0e5f048 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -829,11 +829,30 @@ VulkanCommandProcessor::~VulkanCommandProcessor() = default;
 
 namespace {
 
-// FH1 (#45): the command processor thread's CPU time, in ms (0 where not known: Windows,
-// whose thread times advance in scheduler ticks).
+// FH1 (#45): the command processor thread's CPU time, in ms (0 where not known). Windows
+// (#400): the thread's cycles (QueryThreadCycleTime, counted at the time stamp counter's fixed
+// rate; GetThreadTimes only advances in scheduler ticks) over that rate, measured once against
+// QueryPerformanceCounter for 2 ms (fh1_frame_cost.h CyclesPerMs).
 double ThreadCpuMs() {
 #if REX_PLATFORM_WIN32
+#if REX_ARCH_AMD64
+  static const double cycles_per_ms = [] {
+    LARGE_INTEGER frequency, first, last;
+    if (!QueryPerformanceFrequency(&frequency) || !QueryPerformanceCounter(&first)) return 0.0;
+    const uint64_t tsc_first = __rdtsc();
+    do {
+      QueryPerformanceCounter(&last);
+    } while (last.QuadPart - first.QuadPart < frequency.QuadPart / 500);
+    const uint64_t tsc_last = __rdtsc();
+    return fh1_frame_cost::CyclesPerMs(tsc_first, tsc_last, first.QuadPart, last.QuadPart,
+                                       frequency.QuadPart);
+  }();
+  ULONG64 cycles = 0;
+  if (cycles_per_ms <= 0 || !QueryThreadCycleTime(GetCurrentThread(), &cycles)) return 0;
+  return fh1_frame_cost::CyclesToMs(cycles, cycles_per_ms);
+#else
   return 0;
+#endif
 #else
   timespec ts;
   if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) != 0) return 0;
