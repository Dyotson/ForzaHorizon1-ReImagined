diff --git a/src/graphics/vulkan/fh1_native_world_color.cpp b/src/graphics/vulkan/fh1_native_world_color.cpp
new file mode 100644
index 0000000..acb3be9
--- /dev/null
+++ b/src/graphics/vulkan/fh1_native_world_color.cpp
@@ -0,0 +1,83 @@
+#include <rex/graphics/vulkan/fh1_native_world_color.h>
+#include <rex/graphics/vulkan/fh1_native_geometry.h>
+#include <rex/ui/vulkan/device.h>
+#include <rex/logging.h>
+#include <cstring>
+#include <stdexcept>
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+#include "world_color_pass.h"
+#include "fh1_native_world_color_shaders.h"
+#include <atomic>
+#include <type_traits>
+#include <unordered_map>
+namespace rex::graphics::vulkan {
+namespace nr=forza::native_renderer;
+static_assert(std::is_trivially_copyable_v<nr::WorldColorPass::Dispatch>);
+static_assert(sizeof(nr::WorldColorPass::Dispatch)<=256);
+static_assert(alignof(Fh1NativeWorldColor::Packet)<=alignof(uintmax_t));
+struct Fh1NativeWorldColor::State {
+  const ui::vulkan::VulkanDevice* device;
+  nr::GeometryVulkanDispatch functions;
+  struct Pool {std::unique_ptr<nr::WorldColorPass> pass;uint32_t next=0;};
+  std::unordered_map<uint64_t,Pool> pools;
+  std::vector<uint32_t> vertex,fragment;
+  uint64_t prepared=0;
+  bool failed=false;
+};
+Fh1NativeWorldColor::Fh1NativeWorldColor(const ui::vulkan::VulkanDevice* device):state_(std::make_unique<State>()) {
+  state_->device=device;
+  auto load=[&](const char* name){const auto& i=*device->vulkan_instance();return std::string_view(name).starts_with("vkGetPhysicalDevice")?
+      i.functions().vkGetInstanceProcAddr(i.instance(),name):i.functions().vkGetDeviceProcAddr(device->device(),name);};
+#define LOAD(name) state_->functions.name=reinterpret_cast<PFN_##name>(load(#name));
+  FORZA_NATIVE_VULKAN_FUNCTIONS(LOAD)
+  FORZA_NATIVE_GEOMETRY_VULKAN_FUNCTIONS(LOAD)
+#undef LOAD
+  if(!state_->functions.Valid())throw std::runtime_error("World-color Vulkan functions unavailable");
+  std::string error;
+  if(!CompileFh1Vertex(kFh1NativeWorldVertex,state_->vertex,error) ||
+      !CompileFh1Fragment(kFh1NativeWorldFragment,state_->fragment,error))throw std::runtime_error("World-color shader: "+error);
+}
+Fh1NativeWorldColor::~Fh1NativeWorldColor()=default;
+std::optional<Fh1NativeWorldColor::Packet> Fh1NativeWorldColor::Prepare(VkRenderPass render_pass,const Source& source,uint64_t submission,uint64_t completed) {
+  auto& state=*state_;if(state.failed)return {};
+  nr::WorldColorParameters p;
+  std::memcpy(p.color.data(),source.color.data(),sizeof(p.color));std::memcpy(p.view.data(),source.view.data(),sizeof(p.view));
+  std::copy(source.ndc_scale.begin(),source.ndc_scale.end(),p.ndc_scale.begin());std::copy(source.ndc_offset.begin(),source.ndc_offset.end(),p.ndc_offset.begin());
+  p.scene_noise_bias=source.scene_noise_bias;p.bloom_lut_bias=source.bloom_lut_bias;p.input_scale=source.input_scale;p.exposure_bias_scale=source.exposure_bias_scale;
+  p.rules={source.endian,source.gamma,0,0};
+  if(!nr::Valid(p))return {};
+  try {
+    uint64_t key=(uint64_t(source.dynamic_rendering)<<32)|uint32_t(source.depth_format);
+    auto found=state.pools.find(key);
+    if(found==state.pools.end()){
+      if(state.pools.size()>=4)return {};
+      State::Pool pool;pool.pass=std::make_unique<nr::WorldColorPass>();
+      nr::WorldColorPass::Config config{render_pass,VK_FORMAT_A2B10G10R10_UNORM_PACK32,source.depth_format,8,source.dynamic_rendering};
+      pool.pass->Initialize(state.functions,state.device->physical_device(),state.device->device(),config,state.vertex,state.fragment);
+      found=state.pools.emplace(key,std::move(pool)).first;
+    }
+    auto& pool=found->second;
+    for(uint32_t attempt=0;attempt<8;++attempt){uint32_t slot=(pool.next+attempt)%8;
+      nr::WorldColorPass::Images images{source.images[0],source.images[1],source.images[2],source.images[3],source.images[4]};
+      auto draw=pool.pass->Prepare(slot,{source.buffer,source.vertex_offset,source.buffer_bytes},images,p,source.viewport,source.scissor,submission,completed);
+      if(!draw)continue;pool.next=(slot+1)%8;
+      Packet packet;packet.pass=pool.pass.get();std::memcpy(packet.token.data(),&*draw,sizeof(*draw));
+      if(++state.prepared==1 || state.prepared%120==0)REXGPU_INFO("FH1 native world color: prepared region {} ({}x{} at {},{}, submission {})",state.prepared,source.viewport.width,source.viewport.height,source.viewport.x,source.viewport.y,submission);
+      return packet;
+    }
+  }catch(const std::exception& error){state.failed=true;REXGPU_ERROR("Native world-color disabled; original pass retained: {}",error.what());}
+  return {};
+}
+void Fh1NativeWorldColor::RecordUploads(VkCommandBuffer command,const Packet& packet){nr::WorldColorPass::Dispatch draw;std::memcpy(&draw,packet.token.data(),sizeof(draw));static_cast<const nr::WorldColorPass*>(packet.pass)->Upload(command,draw);}
+void Fh1NativeWorldColor::Record(VkCommandBuffer command,const Packet& packet){nr::WorldColorPass::Dispatch draw;std::memcpy(&draw,packet.token.data(),sizeof(draw));static_cast<const nr::WorldColorPass*>(packet.pass)->Draw(command,draw);}
+}
+#else
+namespace rex::graphics::vulkan {
+struct Fh1NativeWorldColor::State {};
