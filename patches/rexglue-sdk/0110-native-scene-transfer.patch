+  static uint64_t count=0;
+  if(++count==1 || count%120==0)REXGPU_INFO("FH1 native scene snapshot: sampled {} ({}x{}, original untiling skipped)",count,image.width,image.height);
+  return true;
+#else
+  (void)texture;return false;
+#endif
