+struct VulkanTextureCache::NativeSceneState {
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+  forza::native_renderer::SceneSnapshotTracker tracker;
+  struct Image {
+    VkImage image=VK_NULL_HANDLE;VmaAllocation allocation=nullptr;VkImageView view=VK_NULL_HANDLE;
+    uint32_t width=0,height=0;uint64_t bytes=0;VkImageLayout layout=VK_IMAGE_LAYOUT_UNDEFINED;
+    forza::native_renderer::SceneSnapshotKey key{};
+  };
+  std::array<Image,forza::native_renderer::SceneSnapshotTracker::kSlots> images{};
+  uint64_t allocated_bytes=0;
+  rex::thread::global_critical_region critical;
+#endif
+};
+void VulkanTextureCache::NativeSceneInvalidated(const std::unique_lock<std::recursive_mutex>&,
+    void* context,uint32_t first,uint32_t last,bool) {
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+  auto* cache=static_cast<VulkanTextureCache*>(context);
+  if(cache->native_scene_)cache->native_scene_->tracker.Invalidate(first,last);
+#endif
+}
+void VulkanTextureCache::ShutdownNativeScene() {
+  if(native_scene_watch_){shared_memory().UnregisterGlobalWatch(native_scene_watch_);native_scene_watch_=nullptr;}
+#if defined(REXGLUE_FH1_NATIVE_RENDERER)
+  if(native_scene_)for(auto& image:native_scene_->images)if(image.image){
+    command_processor_.GetVulkanDevice()->functions().vkDestroyImageView(command_processor_.GetVulkanDevice()->device(),image.view,nullptr);
+    vmaDestroyImage(vma_allocator_,image.image,image.allocation);
