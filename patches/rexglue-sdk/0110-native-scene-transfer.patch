+      key.GetDepthOrArraySize()!=1 || key.signed_separate || key.format!=xenos::TextureFormat::k_2_10_10_10 ||
+      key.scaled_resolve!=IsDrawResolutionScaled() || GetHostFormatPair(key).format_unsigned.format!=VK_FORMAT_A2B10G10R10_UNORM_PACK32)return false;
