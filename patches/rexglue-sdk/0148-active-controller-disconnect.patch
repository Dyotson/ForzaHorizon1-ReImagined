 }
+
+// A monotonically advancing event sequence, not the merged connected-user mask:
+// keyboard emulation can keep that mask connected after a physical pad is gone.
+// No class layout/vtable changes and no enumeration from the calling thread.
+extern "C" FORZA_TRIGGER_EXPORT uint32_t ForzaInputDisconnectSequence(uint32_t user_mask) {
+  uint32_t sequence = 0;
+  for (uint32_t user = 0; user < rex::input::kMaxGuestUsers; ++user) {
+    if (user_mask & (1u << user)) {
+      sequence += rex::input::physical_disconnects[user].load(std::memory_order_relaxed);
+    }
+  }
+  return sequence;
+}
