+void VulkanPipelineCache::DestroyDriverPipelineCache() {
+  std::unique_lock lock(driver_pipeline_mutex_);
+  if (driver_pipeline_cache_ != VK_NULL_HANDLE && destroy_driver_cache_) {
+    destroy_driver_cache_(command_processor_.GetVulkanDevice()->device(), driver_pipeline_cache_, nullptr);
+  }
+  driver_pipeline_cache_ = VK_NULL_HANDLE;
+  driver_cache_path_.clear();
+  driver_cache_generation_ = 0;
+  driver_cache_saved_generation_ = 0;
+}
+
+void VulkanPipelineCache::InitializeDriverPipelineCache(const std::filesystem::path& root,
+                                                        uint32_t title_id) {
+  DestroyDriverPipelineCache();
+  if (!REXCVAR_GET(vulkan_store_pipeline_cache)) return;
+  std::unique_lock lock(driver_pipeline_mutex_);
+  const auto* gpu = command_processor_.GetVulkanDevice();
+  const auto& functions = gpu->vulkan_instance()->functions();
+  create_driver_cache_ = reinterpret_cast<PFN_vkCreatePipelineCache>(
+      functions.vkGetDeviceProcAddr(gpu->device(), "vkCreatePipelineCache"));
+  get_driver_cache_data_ = reinterpret_cast<PFN_vkGetPipelineCacheData>(
+      functions.vkGetDeviceProcAddr(gpu->device(), "vkGetPipelineCacheData"));
+  destroy_driver_cache_ = reinterpret_cast<PFN_vkDestroyPipelineCache>(
+      functions.vkGetDeviceProcAddr(gpu->device(), "vkDestroyPipelineCache"));
+  if (!create_driver_cache_ || !get_driver_cache_data_ || !destroy_driver_cache_) return;
+  VkPhysicalDeviceProperties properties;
+  functions.vkGetPhysicalDeviceProperties(gpu->physical_device(), &properties);
+  driver_cache_identity_.vendor = properties.vendorID;
+  driver_cache_identity_.device = properties.deviceID;
+  driver_cache_identity_.driver = properties.driverVersion;
+  driver_cache_identity_.abi = (uint64_t(PipelineDescription::kVersion) << 32) |
+      uint64_t(SpirvShaderTranslator::Modification::kVersion);
+  std::copy_n(properties.pipelineCacheUUID, VK_UUID_SIZE, driver_cache_identity_.uuid.begin());
+  driver_cache_path_ = root / "shaders" / "local" / fmt::format(
+      "{:08X}-{:08X}-{:08X}-{:08X}-{:016X}.vkpc", title_id, properties.vendorID,
+      properties.deviceID, properties.driverVersion, driver_cache_identity_.abi);
+  const auto bytes = driver_cache_file::Read(driver_cache_path_, driver_cache_identity_);
+  VkPipelineCacheCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  info.initialDataSize = bytes.size();
+  info.pInitialData = bytes.empty() ? nullptr : bytes.data();
+  auto result = create_driver_cache_(gpu->device(), &info, nullptr, &driver_pipeline_cache_);
+  if (result != VK_SUCCESS && !bytes.empty()) {
+    info.initialDataSize = 0; info.pInitialData = nullptr;
+    result = create_driver_cache_(gpu->device(), &info, nullptr, &driver_pipeline_cache_);
+  }
+  if (result != VK_SUCCESS) {
+    driver_pipeline_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("Vulkan driver pipeline cache unavailable ({}); compiling normally", int32_t(result));
+  } else {
+    REXGPU_INFO("Vulkan driver pipeline cache: {} bytes supplied for startup warm-up", info.initialDataSize);
+  }
+}
+
+void VulkanPipelineCache::SaveDriverPipelineCache() {
+  std::vector<uint8_t> bytes;
+  std::filesystem::path path;
+  driver_cache_file::Identity identity;
+  uint64_t generation;
+  {
+    // GetData's size and data queries must see the same cache contents. Readers
+    // permit concurrent driver-synchronized pipeline creation; this writer
+    // excludes it only while taking a snapshot, never while writing to disk.
+    std::unique_lock lock(driver_pipeline_mutex_);
+    generation = driver_cache_generation_.load();
+    if (!driver_pipeline_cache_ || !get_driver_cache_data_ || !generation ||
+        generation == driver_cache_saved_generation_ || driver_cache_path_.empty()) return;
+    const VkDevice device = command_processor_.GetVulkanDevice()->device();
+    size_t size = 0;
+    if (get_driver_cache_data_(device, driver_pipeline_cache_, &size, nullptr) != VK_SUCCESS ||
+        size < 32 || size > driver_cache_file::kMaxPayload) return;
+    bytes.resize(size);
+    if (get_driver_cache_data_(device, driver_pipeline_cache_, &size, bytes.data()) != VK_SUCCESS) return;
+    bytes.resize(size);
+    path = driver_cache_path_; identity = driver_cache_identity_;
+  }
+  if (driver_cache_file::Write(path, bytes, identity)) {
+    std::unique_lock lock(driver_pipeline_mutex_);
+    if (path == driver_cache_path_) driver_cache_saved_generation_ = generation;
+    REXGPU_INFO("Vulkan driver pipeline cache: saved {} bytes", bytes.size());
+  } else {
+    REXGPU_WARN("Could not save Vulkan driver pipeline cache; existing cache retained");
+  }
+}
