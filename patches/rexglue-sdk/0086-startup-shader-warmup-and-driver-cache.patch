diff --git a/include/rex/graphics/vulkan/driver_cache_file.h b/include/rex/graphics/vulkan/driver_cache_file.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/driver_cache_file.h
@@ -0,0 +1,120 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstddef>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace rex::graphics::vulkan::driver_cache_file {
+// Files contain opaque, locally generated driver data. Never distribute them.
+constexpr size_t kMaxPayload = 64 * 1024 * 1024;
+constexpr size_t kHeaderSize = 64;
+struct Identity {
+  uint32_t vendor = 0, device = 0, driver = 0;
+  uint64_t abi = 0;
+  std::array<uint8_t, 16> uuid{};
+};
+inline uint32_t U32(const uint8_t* p) {
+  return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+inline uint64_t U64(const uint8_t* p) { return U32(p) | uint64_t(U32(p + 4)) << 32; }
+inline void Put32(uint8_t* p, uint32_t v) {
+  for (size_t i = 0; i < 4; ++i) p[i] = uint8_t(v >> (i * 8));
+}
+inline void Put64(uint8_t* p, uint64_t v) { Put32(p, uint32_t(v)); Put32(p + 4, uint32_t(v >> 32)); }
+inline uint64_t Checksum(const uint8_t* data, size_t size) {
+  uint64_t hash = UINT64_C(14695981039346656037);
+  for (size_t i = 0; i < size; ++i) hash = (hash ^ data[i]) * UINT64_C(1099511628211);
+  return hash;
+}
+inline bool ValidPayload(const std::vector<uint8_t>& p, const Identity& id) {
+  // Vulkan's VERSION_ONE header uses little-endian fields independent of the host.
+  return p.size() >= 32 && p.size() <= kMaxPayload && U32(p.data()) >= 32 &&
+      U32(p.data()) <= p.size() && U32(p.data() + 4) == 1 &&
+      U32(p.data() + 8) == id.vendor && U32(p.data() + 12) == id.device &&
+      std::equal(id.uuid.begin(), id.uuid.end(), p.begin() + 16);
+}
+inline std::vector<uint8_t> Encode(const std::vector<uint8_t>& payload, const Identity& id) {
+  if (!ValidPayload(payload, id)) return {};
+  std::vector<uint8_t> result(kHeaderSize + payload.size());
+  const uint8_t magic[8] = {'F','H','1','V','K','P','C',0};
+  std::copy_n(magic, 8, result.begin());
+  Put32(result.data() + 8, 1);
+  Put32(result.data() + 12, id.vendor); Put32(result.data() + 16, id.device);
+  Put32(result.data() + 20, id.driver); Put64(result.data() + 24, id.abi);
+  std::copy(id.uuid.begin(), id.uuid.end(), result.begin() + 32);
+  Put64(result.data() + 48, payload.size());
+  Put64(result.data() + 56, Checksum(payload.data(), payload.size()));
+  std::copy(payload.begin(), payload.end(), result.begin() + kHeaderSize);
+  return result;
+}
+inline std::vector<uint8_t> Decode(const std::vector<uint8_t>& file, const Identity& id) {
+  if (file.size() < kHeaderSize + 32 || file.size() > kHeaderSize + kMaxPayload) return {};
+  const uint8_t magic[8] = {'F','H','1','V','K','P','C',0};
+  if (!std::equal(magic, magic + 8, file.begin()) || U32(file.data() + 8) != 1 ||
+      U32(file.data() + 12) != id.vendor || U32(file.data() + 16) != id.device ||
+      U32(file.data() + 20) != id.driver || U64(file.data() + 24) != id.abi ||
+      !std::equal(id.uuid.begin(), id.uuid.end(), file.begin() + 32) ||
+      U64(file.data() + 48) != file.size() - kHeaderSize ||
+      U64(file.data() + 56) != Checksum(file.data() + kHeaderSize, file.size() - kHeaderSize)) return {};
+  std::vector<uint8_t> result(file.begin() + kHeaderSize, file.end());
+  return ValidPayload(result, id) ? result : std::vector<uint8_t>{};
+}
+inline std::vector<uint8_t> Read(const std::filesystem::path& path, const Identity& id) {
+  std::error_code ec;
+  const auto size = std::filesystem::file_size(path, ec);
+  if (ec || size < kHeaderSize + 32 || size > kHeaderSize + kMaxPayload) return {};
+  std::vector<uint8_t> bytes(size);
+  std::ifstream file(path, std::ios::binary);
+  if (!file.read(reinterpret_cast<char*>(bytes.data()), std::streamsize(size))) return {};
+  return Decode(bytes, id);
+}
+inline bool Write(const std::filesystem::path& path, const std::vector<uint8_t>& payload,
+                  const Identity& id) {
+  auto bytes = Encode(payload, id);
+  if (bytes.empty()) return false;
+  std::error_code ec;
+  std::filesystem::create_directories(path.parent_path(), ec);
+  if (ec) return false;
+  static std::atomic<uint64_t> serial{0};
+#ifdef _WIN32
+  const uint64_t pid = GetCurrentProcessId();
+#else
+  const uint64_t pid = uint64_t(getpid());
+#endif
+  auto temporary = path;
+  temporary += ".tmp-" + std::to_string(pid) + "-" + std::to_string(
+      std::chrono::steady_clock::now().time_since_epoch().count()) + "-" + std::to_string(serial++);
+  bool written = false;
+  {
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    if (file.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()))) {
+      file.flush();
+      if (file) { file.close(); written = !file.fail(); }
+    }
+  }
+  if (written) {
+#ifdef _WIN32
+    written = MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    std::filesystem::rename(temporary, path, ec); written = !ec;
+#endif
+  }
+  if (!written) std::filesystem::remove(temporary, ec);
+  return written;
+}
+}  // namespace rex::graphics::vulkan::driver_cache_file
