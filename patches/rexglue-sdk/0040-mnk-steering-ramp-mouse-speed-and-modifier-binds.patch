+// Time-based state of GetDeviceState, which the game polls at its own rate (several times a
+// frame at times). Only the one keyboard and mouse device exists, and its state mutex is held.
+struct StickState {
+  float value = 0.0f;  // -1..1
+};
+StickState left_stick_x, left_stick_y;
+float mouse_rate_x = 0.0f, mouse_rate_y = 0.0f;  // low-passed pixels per second
+std::chrono::steady_clock::time_point last_poll{};
+
+// A key moves the stick from 0 to kRampStart at once (a short tap must clear the game's
+// dead zone), then to full over `ramp` seconds; letting go takes half as long.
+constexpr float kRampStart = 0.6f;
+
+float RampAxis(StickState& axis, float target, float dt, float ramp) {
+  if (ramp <= 0.0f) {
+    axis.value = target;
+    return axis.value;
+  }
+  const float attack = dt / ramp;
+  const bool releasing = target == 0.0f || (axis.value != 0.0f && (target > 0) != (axis.value > 0));
+  if (releasing) {
+    const float next = std::fabs(axis.value) - 2.0f * attack;
+    axis.value = (next > 0.0f ? next : 0.0f) * (axis.value < 0 ? -1.0f : 1.0f);
+    if (target == 0.0f) {
+      return axis.value;
+    }
+    if (axis.value != 0.0f) {
+      return axis.value;
+    }
+  }
+  float mag = std::fabs(axis.value);
+  if (mag < kRampStart) {
+    mag = kRampStart;
+  }
+  mag = std::min(1.0f, mag + attack);
+  axis.value = target < 0 ? -mag : mag;
+  return axis.value;
+}
