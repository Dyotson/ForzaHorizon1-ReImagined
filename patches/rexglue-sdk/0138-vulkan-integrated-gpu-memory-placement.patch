+  // for the mips.
+  uint64_t size = uint64_t(info.extent.width) * info.extent.height * info.extent.depth *
+                  info.arrayLayers * 4;
+  if (info.mipLevels > 1) size += size / 3;
+  const auto order = state.Choose(device_memory::Use::kTexture, ~uint32_t(0),
