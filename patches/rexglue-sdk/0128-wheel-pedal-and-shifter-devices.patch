+    {0x346E, 0x0013, AuxRole::kPedals, "Moza mBooster", 3, 0, 1, 2},             // PMR (compatible mode)
+    // HGP: reverse 4, gears 1-7 on 5-11 (PMR).
+    {0x346E, 0x001E, AuxRole::kShifter, "Moza HGP", 0, -1, -1, -1, 5, 7, 4},
