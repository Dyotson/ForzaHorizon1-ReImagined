+      break;
+    case xenos::Endian::k8in32:
+      for (size_t i = 0; i + 3 < size; i += 4) {
+        std::swap(data[i], data[i + 3]);
+        std::swap(data[i + 1], data[i + 2]);
+      }
+      break;
+    case xenos::Endian::k16in32:
+      for (size_t i = 0; i + 3 < size; i += 4) {
+        std::swap(data[i], data[i + 2]);
+        std::swap(data[i + 1], data[i + 3]);
