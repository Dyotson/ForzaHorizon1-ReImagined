+void TextureCache::ResolveTexturePacks() {
+  packs_ = texture_pack::Packs::Get();
+  packs_state_ = packs_ ? 1 : 0;
+  if (packs_ && packs_->replacing() && !SupportsTexturePackReplacement()) {
+    static bool logged = false;
