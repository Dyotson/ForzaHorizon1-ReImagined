+Format GuestFormatFile(xenos::TextureFormat format) {
+  // Each holds what the host texture's channels hold (the Vulkan texture cache's host formats),
+  // so a replacement in the same layout is sampled through the same swizzle.
+  switch (format) {
+    case xenos::TextureFormat::k_8:
+      return Format::kR8;
+    case xenos::TextureFormat::k_8_8:
+      return Format::kRG8;
+    case xenos::TextureFormat::k_8_8_8_8:
+      return Format::kRGBA8;
+    case xenos::TextureFormat::k_DXT1:
+      return Format::kBC1;
+    case xenos::TextureFormat::k_DXT2_3:
+      return Format::kBC2;
+    case xenos::TextureFormat::k_DXT4_5:
+      return Format::kBC3;
+    case xenos::TextureFormat::k_DXT5A:
+      return Format::kBC4;
+    case xenos::TextureFormat::k_DXN:
+      return Format::kBC5;
+    default:
+      return Format::kNone;
+  }
+}
+
+std::vector<uint8_t> UntileLevel(const GuestTexture& texture,
+                                 const texture_util::TextureGuestLayout& layout,
+                                 const uint8_t* base, uint32_t base_size, const uint8_t* mips,
+                                 uint32_t mips_size, uint32_t level) {
+  const FormatInfo* info = FormatInfo::Get(texture.format);
+  const uint32_t block_width = info->block_width, block_height = info->block_height;
+  const uint32_t block_bytes = info->bytes_per_block();
+  if (!block_bytes || (block_bytes & (block_bytes - 1))) return {};
+  const uint32_t block_bytes_log2 = uint32_t(std::countr_zero(block_bytes));
+  const uint32_t width = std::max(texture.width >> level, 1u);
+  const uint32_t height = std::max(texture.height >> level, 1u);
+  const uint32_t width_blocks = (width + block_width - 1) / block_width;
+  const uint32_t height_blocks = (height + block_height - 1) / block_height;
+  const uint32_t packed = layout.packed_level;
+  const uint8_t* source;
+  size_t source_size;
+  const texture_util::TextureGuestLayout::Level* level_layout;
+  if (level == 0) {
+    source = base;
+    source_size = base_size;
+    level_layout = &layout.base;
+  } else {
+    const uint32_t stored = std::min(level, packed);
+    if (!mips || stored >= xenos::kTextureMaxMips) return {};
+    const uint32_t offset = layout.mip_offsets_bytes[stored];
+    if (offset >= mips_size) return {};
+    source = mips + offset;
+    source_size = mips_size - offset;
+    level_layout = &layout.mips[stored];
+  }
+  uint32_t offset_x = 0, offset_y = 0, offset_z = 0;
+  if (level >= packed) {
+    texture_util::GetPackedMipOffset(texture.width, texture.height, 1, texture.format, level,
+                                     offset_x, offset_y, offset_z);
+  }
+  const uint32_t pitch_bytes = level_layout->row_pitch_bytes;
+  if (!pitch_bytes) return {};
+  std::vector<uint8_t> out(size_t(width_blocks) * height_blocks * block_bytes);
+  for (uint32_t y = 0; y < height_blocks; ++y) {
+    for (uint32_t x = 0; x < width_blocks; ++x) {
+      const uint32_t source_x = x + offset_x, source_y = y + offset_y;
+      const size_t offset =
+          texture.tiled ? size_t(uint32_t(texture_util::GetTiledOffset2D(
+                              int32_t(source_x), int32_t(source_y), pitch_bytes / block_bytes,
+                              block_bytes_log2)))
+                        : size_t(source_y) * pitch_bytes + size_t(source_x) * block_bytes;
+      if (offset + block_bytes <= source_size) {
+        std::memcpy(&out[(size_t(y) * width_blocks + x) * block_bytes], source + offset,
+                    block_bytes);
+      }
+    }
+  }
+  return out;
+}
+
+std::vector<uint8_t> EncodeDds(Format format, uint32_t width, uint32_t height,
+                               const std::vector<std::vector<uint8_t>>& levels) {
+  uint32_t header[31] = {};
+  bool dx10 = false;
+  uint32_t dxgi = 0;
+  header[0] = 124;
+  header[1] = 0x1 | 0x2 | 0x4 | 0x1000;  // caps, height, width, pixel format
+  header[2] = height;
+  header[3] = width;
+  header[6] = uint32_t(levels.size());
+  if (levels.size() > 1) header[1] |= 0x20000;  // mip map count
+  header[18] = 32;
+  if (IsBlockCompressed(format)) {
+    header[1] |= 0x80000;  // linear size
+    header[4] = uint32_t(LevelBytes(format, width, height));
+    header[19] = 0x4;  // four CC
+  } else {
+    header[1] |= 0x8;  // pitch
+    header[4] = width * ElementBytes(format);
+  }
+  switch (format) {
+    case Format::kBC1:
+      header[20] = FourCC('D', 'X', 'T', '1');
+      break;
+    case Format::kBC2:
+      header[20] = FourCC('D', 'X', 'T', '3');
+      break;
+    case Format::kBC3:
+      header[20] = FourCC('D', 'X', 'T', '5');
+      break;
+    case Format::kBC4:
+      header[20] = FourCC('A', 'T', 'I', '1');
+      break;
+    case Format::kBC5:
+      header[20] = FourCC('A', 'T', 'I', '2');
+      break;
+    case Format::kBC7:
+      dx10 = true;
+      dxgi = 98;  // DXGI_FORMAT_BC7_UNORM
+      break;
+    case Format::kRGBA8:
+    case Format::kBGRA8:
+      header[19] = 0x40 | 0x1;  // RGB, alpha pixels
+      header[21] = 32;
+      header[22] = format == Format::kRGBA8 ? 0x000000FF : 0x00FF0000;
+      header[23] = 0x0000FF00;
+      header[24] = format == Format::kRGBA8 ? 0x00FF0000 : 0x000000FF;
+      header[25] = 0xFF000000;
+      break;
+    case Format::kR8:
+      header[19] = 0x20000;  // luminance
+      header[21] = 8;
+      header[22] = 0xFF;
+      break;
+    case Format::kRG8:
+      dx10 = true;
+      dxgi = 49;  // DXGI_FORMAT_R8G8_UNORM
+      break;
+    default:
+      return {};
+  }
+  if (dx10) {
+    header[19] = 0x4;
+    header[20] = FourCC('D', 'X', '1', '0');
+  }
+  header[26] = 0x1000;  // texture
+  if (levels.size() > 1) header[26] |= 0x8 | 0x400000;  // complex, mip map
+  std::vector<uint8_t> out(4 + sizeof(header));
+  std::memcpy(out.data(), "DDS ", 4);
+  std::memcpy(out.data() + 4, header, sizeof(header));
+  if (dx10) {
+    const uint32_t extension[5] = {dxgi, 3 /* 2D */, 0, 1, 0};
+    out.insert(out.end(), reinterpret_cast<const uint8_t*>(extension),
+               reinterpret_cast<const uint8_t*>(extension) + sizeof(extension));
+  }
+  for (const std::vector<uint8_t>& level : levels) out.insert(out.end(), level.begin(), level.end());
+  return out;
+}
+
+bool DecodeDds(const uint8_t* data, size_t size, Decoded& out, std::string& error) {
+  if (size < 128 || std::memcmp(data, "DDS ", 4)) {
+    error = "not a DDS file";
+    return false;
+  }
+  uint32_t header[31];
+  std::memcpy(header, data + 4, sizeof(header));
+  if (header[0] != 124) {
+    error = "bad DDS header";
+    return false;
+  }
+  const uint32_t flags = header[1], height = header[2], width = header[3];
+  const uint32_t pixel_flags = header[19], four_cc = header[20], bits = header[21];
+  if (header[27] & 0x200) {
+    error = "cube maps are not supported yet";
+    return false;
+  }
+  if ((header[27] & 0x200000) || ((flags & 0x800000) && header[5] > 1)) {
+    error = "volume textures are not supported yet";
+    return false;
+  }
+  size_t offset = 128;
+  Format format = Format::kNone;
+  bool fill_alpha = false;
+  if (pixel_flags & 0x4) {
+    if (four_cc == FourCC('D', 'X', 'T', '1')) {
+      format = Format::kBC1;
+    } else if (four_cc == FourCC('D', 'X', 'T', '2') || four_cc == FourCC('D', 'X', 'T', '3')) {
+      format = Format::kBC2;
+    } else if (four_cc == FourCC('D', 'X', 'T', '4') || four_cc == FourCC('D', 'X', 'T', '5')) {
+      format = Format::kBC3;
+    } else if (four_cc == FourCC('A', 'T', 'I', '1') || four_cc == FourCC('B', 'C', '4', 'U')) {
+      format = Format::kBC4;
+    } else if (four_cc == FourCC('A', 'T', 'I', '2') || four_cc == FourCC('B', 'C', '5', 'U')) {
+      format = Format::kBC5;
+    } else if (four_cc == FourCC('D', 'X', '1', '0')) {
+      if (size < 148) {
+        error = "truncated DX10 header";
+        return false;
+      }
+      uint32_t extension[5];
+      std::memcpy(extension, data + 128, sizeof(extension));
+      offset = 148;
+      if (extension[1] != 3 || extension[3] > 1 || (extension[2] & 0x4)) {
+        error = "only single 2D textures are supported (no arrays or cube maps)";
+        return false;
+      }
+      switch (extension[0]) {
+        case 71:  // BC1_UNORM
+        case 72:  // BC1_UNORM_SRGB (sampled as UNORM: the game does its own gamma)
+          format = Format::kBC1;
+          break;
+        case 74:
+        case 75:
+          format = Format::kBC2;
+          break;
+        case 77:
+        case 78:
+          format = Format::kBC3;
+          break;
+        case 80:
+          format = Format::kBC4;
+          break;
+        case 83:
+          format = Format::kBC5;
+          break;
+        case 98:
+        case 99:
+          format = Format::kBC7;
+          break;
+        case 28:
+        case 29:
+          format = Format::kRGBA8;
+          break;
+        case 87:
+        case 91:
+          format = Format::kBGRA8;
+          break;
+        case 61:
+          format = Format::kR8;
+          break;
+        case 49:
+          format = Format::kRG8;
+          break;
+        default:
+          error = "unsupported DXGI format " + std::to_string(extension[0]);
+          return false;
+      }
+    } else {
+      error = "unsupported four CC";
+      return false;
+    }
+  } else if ((pixel_flags & 0x40) && bits == 32) {
+    if (header[22] == 0xFF && header[23] == 0xFF00 && header[24] == 0xFF0000) {
+      format = Format::kRGBA8;
+    } else if (header[22] == 0xFF0000 && header[23] == 0xFF00 && header[24] == 0xFF) {
+      format = Format::kBGRA8;
+    } else {
+      error = "unsupported 32-bit RGB channel order";
+      return false;
+    }
+    fill_alpha = !(pixel_flags & 0x1);
+  } else if ((pixel_flags & 0x20000) && bits == 8) {
+    format = Format::kR8;
+  } else if ((pixel_flags & 0x20000) && (pixel_flags & 0x1) && bits == 16) {
+    format = Format::kRG8;  // luminance + alpha: R and G
+  } else {
+    error = "unsupported pixel format (use BC1-5/7, RGBA8, BGRA8, R8 or RG8)";
+    return false;
+  }
+  if (!width || !height || width > kMaxReplacementSize || height > kMaxReplacementSize) {
+    error = "bad size " + std::to_string(width) + "x" + std::to_string(height);
+    return false;
+  }
+  uint32_t level_count = (flags & 0x20000) && header[6] ? header[6] : 1;
+  level_count = std::min(level_count, uint32_t(std::bit_width(std::max(width, height))));
+  out.format = format;
+  out.width = width;
+  out.height = height;
+  out.levels.clear();
+  out.data.clear();
+  uint32_t level_width = width, level_height = height;
+  for (uint32_t level = 0; level < level_count; ++level) {
+    const uint64_t level_size = LevelBytes(format, level_width, level_height);
+    if (offset + level_size > size) {
+      if (level == 0) {
+        error = "file too short";
+        return false;
+      }
+      break;  // keep the complete levels
+    }
+    const uint64_t out_offset = (out.data.size() + 15) & ~uint64_t(15);
+    out.data.resize(size_t(out_offset));
+    out.data.insert(out.data.end(), data + offset, data + offset + level_size);
+    out.levels.push_back({out_offset, level_size, level_width, level_height});
+    offset += size_t(level_size);
+    level_width = std::max(level_width / 2, 1u);
+    level_height = std::max(level_height / 2, 1u);
+  }
+  if (fill_alpha) {
+    for (const Level& level : out.levels) {
+      for (uint64_t i = 3; i < level.size; i += 4) out.data[size_t(level.offset + i)] = 255;
+    }
+  }
+  return true;
+}
+
+std::vector<uint8_t> ToRgba8(Format format, uint32_t width, uint32_t height, const uint8_t* data) {
+  std::vector<uint8_t> rgba(size_t(width) * height * 4, 255);
+  auto texel = [&](uint32_t x, uint32_t y) { return &rgba[(size_t(y) * width + x) * 4]; };
+  if (!IsBlockCompressed(format)) {
+    const uint32_t bytes = ElementBytes(format);
+    for (uint32_t y = 0; y < height; ++y) {
+      for (uint32_t x = 0; x < width; ++x) {
+        const uint8_t* in = data + (size_t(y) * width + x) * bytes;
+        uint8_t* out = texel(x, y);
+        switch (format) {
+          case Format::kR8:
+            out[0] = out[1] = out[2] = in[0];
+            break;
+          case Format::kRG8:
+            out[0] = in[0];
+            out[1] = in[1];
+            out[2] = 0;
+            break;
+          case Format::kRGBA8:
+            std::memcpy(out, in, 4);
+            break;
+          case Format::kBGRA8:
+            out[0] = in[2];
+            out[1] = in[1];
+            out[2] = in[0];
+            out[3] = in[3];
+            break;
+          default:
+            break;
+        }
+      }
+    }
+    return rgba;
+  }
+  if (format == Format::kBC7) return {};
+  const uint32_t block_bytes = ElementBytes(format);
+  const uint32_t width_blocks = (width + 3) / 4, height_blocks = (height + 3) / 4;
+  for (uint32_t by = 0; by < height_blocks; ++by) {
+    for (uint32_t bx = 0; bx < width_blocks; ++bx) {
+      const uint8_t* block = data + (size_t(by) * width_blocks + bx) * block_bytes;
+      uint8_t texels[16][4];
+      std::memset(texels, 255, sizeof(texels));
+      switch (format) {
+        case Format::kBC1:
+          DecodeColorBlock(block, texels, true);
+          break;
+        case Format::kBC2:
+          DecodeColorBlock(block + 8, texels, false);
+          for (int i = 0; i < 16; ++i) texels[i][3] = uint8_t((block[i / 2] >> (4 * (i & 1)) & 15) * 17);
+          break;
+        case Format::kBC3:
+          DecodeColorBlock(block + 8, texels, false);
+          DecodeAlphaBlock(block, &texels[0][3], 4);
+          break;
+        case Format::kBC4:
+          DecodeAlphaBlock(block, &texels[0][0], 4);
+          for (int i = 0; i < 16; ++i) texels[i][1] = texels[i][2] = texels[i][0];
+          break;
+        case Format::kBC5:
+          DecodeAlphaBlock(block, &texels[0][0], 4);
+          DecodeAlphaBlock(block + 8, &texels[0][1], 4);
+          for (int i = 0; i < 16; ++i) texels[i][2] = 0;
+          break;
+        default:
+          break;
+      }
+      for (uint32_t i = 0; i < 16; ++i) {
+        const uint32_t x = bx * 4 + (i & 3), y = by * 4 + i / 4;
+        if (x < width && y < height) std::memcpy(texel(x, y), texels[i], 4);
+      }
+    }
+  }
+  return rgba;
+}
+
+std::vector<uint8_t> EncodePng(uint32_t width, uint32_t height, const uint8_t* rgba) {
+  // Each row with the filter that gives the smallest sum of absolute differences.
+  const size_t stride = size_t(width) * 4;
+  std::vector<uint8_t> filtered((stride + 1) * height);
+  std::vector<uint8_t> candidate(stride);
+  for (uint32_t y = 0; y < height; ++y) {
+    const uint8_t* row = rgba + y * stride;
+    const uint8_t* above = y ? row - stride : nullptr;
+    uint64_t best_cost = UINT64_MAX;
+    for (uint8_t filter = 0; filter < 5; ++filter) {
+      if (!above && (filter == 2 || filter == 3 || filter == 4)) continue;
+      uint64_t cost = 0;
+      for (size_t i = 0; i < stride; ++i) {
+        const int a = i >= 4 ? row[i - 4] : 0, b = above ? above[i] : 0,
+                  c = (above && i >= 4) ? above[i - 4] : 0;
+        int predicted = 0;
+        switch (filter) {
+          case 1:
+            predicted = a;
+            break;
+          case 2:
+            predicted = b;
+            break;
+          case 3:
+            predicted = (a + b) / 2;
+            break;
+          case 4: {
+            const int p = a + b - c, pa = std::abs(p - a), pb = std::abs(p - b),
+                      pc = std::abs(p - c);
+            predicted = (pa <= pb && pa <= pc) ? a : (pb <= pc ? b : c);
+            break;
+          }
+          default:
+            break;
+        }
+        candidate[i] = uint8_t(row[i] - predicted);
+        cost += uint64_t(std::abs(int(int8_t(candidate[i]))));
+      }
+      if (cost < best_cost) {
+        best_cost = cost;
+        uint8_t* out = &filtered[y * (stride + 1)];
+        out[0] = filter;
+        std::memcpy(out + 1, candidate.data(), stride);
+      }
+    }
+  }
+  std::vector<uint8_t> png = {0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+  std::vector<uint8_t> ihdr(13);
+  for (int k = 0; k < 4; ++k) {
+    ihdr[k] = uint8_t(width >> (24 - 8 * k));
+    ihdr[4 + k] = uint8_t(height >> (24 - 8 * k));
+  }
+  ihdr[8] = 8;  // bits per channel
+  ihdr[9] = 6;  // RGBA
+  PutChunk(png, "IHDR", ihdr);
+  PutChunk(png, "IDAT", Zlib(filtered.data(), filtered.size()));
+  PutChunk(png, "IEND", {});
+  return png;
+}
+
+std::vector<std::unique_ptr<Decoded>> Client::Take() {
+  std::vector<std::unique_ptr<Decoded>> taken;
+  std::lock_guard<std::mutex> lock(mutex_);
+  taken.swap(ready_);
+  ready_count_.store(0, std::memory_order_release);
+  return taken;
+}
+
+void Client::Put(std::unique_ptr<Decoded> decoded) {
+  pending_bytes_.fetch_add(decoded->data.size(), std::memory_order_acq_rel);
+  std::lock_guard<std::mutex> lock(mutex_);
+  ready_.push_back(std::move(decoded));
+  ready_count_.store(uint32_t(ready_.size()), std::memory_order_release);
+}
